# Dependencies and generated output (the root Dockerfile builds the site).
node_modules/
dist/
site/
.astro/
public/pagefind/

# Archives and documentation are not inputs to the Astro build.
archive/
docs/
README.md
DESIGN.md
PLAN.md
PRODUCT.md
PROJECT.md
CONTENT_CONTRACT.md

# Git, editors, and local tooling.
.git
.github
.vscode/
.claude/
.playwright-cli/
.oil-ui/
.DS_Store

# Local environment files never enter the image build context.
.env*

# Tests and reports. Keep tsconfig.json for the Astro/React build.
playwright.config.*
vitest.config.*
vitest.setup.*
**/__tests__/
*.test.*
*.spec.*
e2e/
coverage/
test-results/
playwright-report/
blob-report/
*.tsbuildinfo

# Separate deployment and authoring tools.
# Other Dockerfiles have their own complete ignore rules.
infra/
scripts/
