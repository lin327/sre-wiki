FROM nginx:alpine

LABEL org.opencontainers.image.source="https://github.com/lin327/sre-wiki"
LABEL org.opencontainers.image.description="SRE Atlas - AI-driven operations knowledge base"
LABEL org.opencontainers.image.version="1.5"

# http-context map of archived URLs (exact 410). Included via conf.d/*.conf.
COPY nginx/legacy-redirects.map /etc/nginx/conf.d/00-legacy-redirects.conf
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY dist/ /usr/share/nginx/html/

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost/healthz || exit 1
