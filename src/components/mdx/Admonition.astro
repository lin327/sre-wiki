---
type AdmonitionType = "note" | "tip" | "warning" | "error";

interface Props {
  type: AdmonitionType;
  title?: string;
}

const { type, title } = Astro.props;

const typeConfig: Record<
  AdmonitionType,
  { class: string; defaultTitle: string; icon: string }
> = {
  note: {
    class: "",
    defaultTitle: "Note",
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>`,
  },
  tip: {
    class: "admonition--success",
    defaultTitle: "Tip",
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4"/><path d="m6.41 6.41-2.83-2.83"/><path d="M2 12h4"/><path d="m6.41 17.59-2.83 2.83"/><path d="M12 18v4"/><path d="m17.59 17.59 2.83 2.83"/><path d="M18 12h4"/><path d="m17.59 6.41 2.83-2.83"/></svg>`,
  },
  warning: {
    class: "admonition--warning",
    defaultTitle: "Warning",
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>`,
  },
  error: {
    class: "admonition--error",
    defaultTitle: "Error",
    icon: `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>`,
  },
};

const config = typeConfig[type];
const displayTitle = title || config.defaultTitle;
---

<div class:list={["admonition", config.class]} role="note" aria-label={displayTitle}>
  <div class="admonition-title">
    <span class="admonition-icon" set:html={config.icon} />
    <span>{displayTitle}</span>
  </div>
  <div class="admonition-body">
    <slot />
  </div>
</div>

<style>
  .admonition {
    margin-block: var(--space-6);
  }

  .admonition-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .admonition-icon {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    opacity: 0.85;
  }

  .admonition-body {
    margin-block-start: var(--space-2);
  }

  .admonition-body :global(p) {
    margin: 0;
  }

  .admonition-body :global(p + p) {
    margin-block-start: var(--space-3);
  }

  .admonition-body :global(ul),
  .admonition-body :global(ol) {
    margin-block: var(--space-2);
    padding-inline-start: var(--space-6);
  }

  .admonition-body :global(code) {
    font-size: 0.85em;
  }
</style>
