---
type AdmonitionType = "note" | "tip" | "warning" | "error";

interface Props {
  type: AdmonitionType;
  title?: string;
}

const { type, title } = Astro.props;

const typeConfig: Record<
  AdmonitionType,
  { class: string; defaultTitle: string; icon: string }
> = {
  note: {
    class: "admonition--note",
    defaultTitle: "Note",
    icon: `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>`,
  },
  tip: {
    class: "admonition--tip",
    defaultTitle: "Tip",
    icon: `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>`,
  },
  warning: {
    class: "admonition--warning",
    defaultTitle: "Warning",
    icon: `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>`,
  },
  error: {
    class: "admonition--error",
    defaultTitle: "Error",
    icon: `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>`,
  },
};

const config = typeConfig[type];
const displayTitle = title || config.defaultTitle;
---

<div class:list={["admonition", config.class]} role="note" aria-label={displayTitle}>
  <div class="admonition-title">
    <span class="admonition-icon" set:html={config.icon} />
    <span>{displayTitle}</span>
  </div>
  <div class="admonition-body">
    <slot />
  </div>
</div>

<style>
  /* ============================================
     Admonition — Scoped Styles
     ============================================ */

  .admonition {
    position: relative;
    margin-block: var(--space-6);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    border-inline-start: 4px solid var(--color-info);
    background-color: var(--color-surface);
    background-image: linear-gradient(
      135deg,
      oklch(from var(--color-info) l c h / 0.06) 0%,
      transparent 60%
    );
    transition:
      transform var(--motion-normal) var(--ease-out-expo),
      box-shadow var(--motion-normal) var(--ease-out-expo);
  }

  .admonition:hover {
    transform: translateY(-2px);
    box-shadow:
      0 4px 16px oklch(from var(--color-info) l c h / 0.12),
      0 0 0 1px oklch(from var(--color-info) l c h / 0.08);
  }

  /* Left-border glow via pseudo-element */
  .admonition::before {
    content: "";
    position: absolute;
    inset-inline-start: -4px;
    inset-block: 0;
    width: 4px;
    border-radius: var(--radius-md) 0 0 var(--radius-md);
    background: var(--color-info);
    box-shadow:
      0 0 8px oklch(from var(--color-info) l c h / 0.5),
      0 0 20px oklch(from var(--color-info) l c h / 0.2);
    opacity: 0;
    transition: opacity var(--motion-normal) var(--ease-out-expo);
  }

  .admonition:hover::before {
    opacity: 1;
  }

  /* ============================================
     Type Variants
     ============================================ */

  .admonition--note {
    border-inline-start-color: var(--color-info);
    background-image: linear-gradient(
      135deg,
      oklch(from var(--color-info) l c h / 0.06) 0%,
      transparent 60%
    );
  }

  .admonition--note::before {
    background: var(--color-info);
    box-shadow:
      0 0 8px oklch(from var(--color-info) l c h / 0.5),
      0 0 20px oklch(from var(--color-info) l c h / 0.2);
  }

  .admonition--note:hover {
    box-shadow:
      0 4px 16px oklch(from var(--color-info) l c h / 0.12),
      0 0 0 1px oklch(from var(--color-info) l c h / 0.08);
  }

  .admonition--note .admonition-icon {
    color: var(--color-info);
  }

  .admonition--tip {
    border-inline-start-color: var(--color-success);
    background-image: linear-gradient(
      135deg,
      oklch(from var(--color-success) l c h / 0.06) 0%,
      transparent 60%
    );
  }

  .admonition--tip::before {
    background: var(--color-success);
    box-shadow:
      0 0 8px oklch(from var(--color-success) l c h / 0.5),
      0 0 20px oklch(from var(--color-success) l c h / 0.2);
  }

  .admonition--tip:hover {
    box-shadow:
      0 4px 16px oklch(from var(--color-success) l c h / 0.12),
      0 0 0 1px oklch(from var(--color-success) l c h / 0.08);
  }

  .admonition--tip .admonition-icon {
    color: var(--color-success);
  }

  .admonition--warning {
    border-inline-start-color: var(--color-warning);
    background-image: linear-gradient(
      135deg,
      oklch(from var(--color-warning) l c h / 0.06) 0%,
      transparent 60%
    );
  }

  .admonition--warning::before {
    background: var(--color-warning);
    box-shadow:
      0 0 8px oklch(from var(--color-warning) l c h / 0.5),
      0 0 20px oklch(from var(--color-warning) l c h / 0.2);
  }

  .admonition--warning:hover {
    box-shadow:
      0 4px 16px oklch(from var(--color-warning) l c h / 0.12),
      0 0 0 1px oklch(from var(--color-warning) l c h / 0.08);
  }

  .admonition--warning .admonition-icon {
    color: var(--color-warning);
  }

  .admonition--error {
    border-inline-start-color: var(--color-error);
    background-image: linear-gradient(
      135deg,
      oklch(from var(--color-error) l c h / 0.06) 0%,
      transparent 60%
    );
  }

  .admonition--error::before {
    background: var(--color-error);
    box-shadow:
      0 0 8px oklch(from var(--color-error) l c h / 0.5),
      0 0 20px oklch(from var(--color-error) l c h / 0.2);
  }

  .admonition--error:hover {
    box-shadow:
      0 4px 16px oklch(from var(--color-error) l c h / 0.12),
      0 0 0 1px oklch(from var(--color-error) l c h / 0.08);
  }

  .admonition--error .admonition-icon {
    color: var(--color-error);
  }

  /* ============================================
     Title Bar
     ============================================ */

  .admonition-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-ink);
  }

  .admonition-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
  }

  /* ============================================
     Body Content
     ============================================ */

  .admonition-body {
    margin-block-start: var(--space-3);
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .admonition-body :global(p) {
    margin: 0;
  }

  .admonition-body :global(p + p) {
    margin-block-start: var(--space-3);
  }

  .admonition-body :global(ul),
  .admonition-body :global(ol) {
    margin-block: var(--space-2);
    padding-inline-start: var(--space-6);
  }

  .admonition-body :global(code) {
    font-size: 0.85em;
    background-color: var(--color-code-bg);
    color: var(--color-code-text);
    padding: 0.12em 0.3em;
    border-radius: var(--radius-sm);
  }

  /* ============================================
     Reduced Motion
     ============================================ */

  @media (prefers-reduced-motion: reduce) {
    .admonition {
      transition: none;
    }

    .admonition:hover {
      transform: none;
    }

    .admonition::before {
      transition: none;
    }
  }
</style>
