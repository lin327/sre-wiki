---
type BadgeType =
  | "linux"
  | "docker"
  | "kubernetes"
  | "runbook"
  | "architecture"
  | "incident"
  | "comparison";

interface Props {
  type: BadgeType;
  label?: string;
}

const { type, label } = Astro.props;

const typeConfig: Record<BadgeType, { label: string; className: string }> = {
  linux: { label: "Linux", className: "badge--linux" },
  docker: { label: "Docker", className: "badge--docker" },
  kubernetes: { label: "Kubernetes", className: "badge--kubernetes" },
  runbook: { label: "Runbook", className: "badge--runbook" },
  architecture: { label: "Architecture", className: "badge--architecture" },
  incident: { label: "Incident", className: "badge--incident" },
  comparison: { label: "Comparison", className: "badge--comparison" },
};

const config = typeConfig[type];
const displayLabel = label || config.label;
---

<span class:list={["badge", config.className]}>
  {displayLabel}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.125em 0.625em;
    border-radius: 999px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
    user-select: none;
    border: 1px solid transparent;
  }

  .badge--linux {
    background-color: #ddf4ff;
    color: #0550ae;
    border-color: #b6e3ff;
  }

  .badge--docker {
    background-color: #ddf4ff;
    color: #0969da;
    border-color: #b6e3ff;
  }

  .badge--kubernetes {
    background-color: #fbefff;
    color: #8250df;
    border-color: #e8d5f5;
  }

  .badge--runbook {
    background-color: #dafbe1;
    color: #116329;
    border-color: #aceebb;
  }

  .badge--architecture {
    background-color: #fff8c5;
    color: #6c4400;
    border-color: #f5e0a0;
  }

  .badge--incident {
    background-color: #ffebe9;
    color: #a40e26;
    border-color: #ffbdb8;
  }

  .badge--comparison {
    background-color: var(--color-surface-2);
    color: var(--color-muted);
    border-color: var(--color-border);
  }

  /* Dark theme overrides */
  [data-theme="dark"] .badge--linux {
    background-color: #0c2d6b;
    color: #58a6ff;
    border-color: #1f3d7d;
  }

  [data-theme="dark"] .badge--docker {
    background-color: #0c2d6b;
    color: #58a6ff;
    border-color: #1f3d7d;
  }

  [data-theme="dark"] .badge--kubernetes {
    background-color: #2d1654;
    color: #d2a8ff;
    border-color: #3d1f6d;
  }

  [data-theme="dark"] .badge--runbook {
    background-color: #0b3d1c;
    color: #56d364;
    border-color: #1a5c2e;
  }

  [data-theme="dark"] .badge--architecture {
    background-color: #3d2800;
    color: #e3b341;
    border-color: #5c3d00;
  }

  [data-theme="dark"] .badge--incident {
    background-color: #4a0e1a;
    color: #f85149;
    border-color: #6d1422;
  }
</style>
