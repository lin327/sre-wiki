---
type BadgeType =
  | "linux"
  | "docker"
  | "kubernetes"
  | "runbook"
  | "architecture"
  | "incident"
  | "comparison";

interface Props {
  type: BadgeType;
  label?: string;
}

const { type, label } = Astro.props;

const typeConfig: Record<BadgeType, { label: string; className: string }> = {
  linux: { label: "Linux", className: "badge--linux" },
  docker: { label: "Docker", className: "badge--docker" },
  kubernetes: { label: "Kubernetes", className: "badge--kubernetes" },
  runbook: { label: "Runbook", className: "badge--runbook" },
  architecture: { label: "Architecture", className: "badge--architecture" },
  incident: { label: "Incident", className: "badge--incident" },
  comparison: { label: "Comparison", className: "badge--comparison" },
};

const config = typeConfig[type];
const displayLabel = label || config.label;
---

<span class:list={["badge", config.className]}>
  {displayLabel}
</span>

<style>
  /* ============================================
     Badge — GitHub Label Style
     ============================================ */

  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.125em 0.625em;
    border-radius: 999px;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
    user-select: none;
    border: 1px solid transparent;
  }

  /* ============================================
     Type Colors
     ============================================ */

  .badge--linux {
    background-color: #ddf4ff;
    color: #0550ae;
    border-color: #b6e3ff;
  }

  .badge--docker {
    background-color: #ddf4ff;
    color: #0969da;
    border-color: #b6e3ff;
  }

  .badge--kubernetes {
    background-color: #fbefff;
    color: #8250df;
    border-color: #e8d5f5;
  }

  .badge--runbook {
    background-color: #dafbe1;
    color: #116329;
    border-color: #aceebb;
  }

  .badge--architecture {
    background-color: #fff8c5;
    color: #6c4400;
    border-color: #f5e0a0;
  }

  .badge--incident {
    background-color: #ffebe9;
    color: #a40e26;
    border-color: #ffbdb8;
  }

  .badge--comparison {
    background-color: #f0f0f0;
    color: #57606a;
    border-color: #d0d7de;
  }
</style>
