---
interface Props {
  /** Border accent color. */
  variant?: "default" | "success" | "warning" | "error";
}

const { variant = "default" } = Astro.props;

const variantClass: Record<string, string> = {
  default: "callout--default",
  success: "callout--success",
  warning: "callout--warning",
  error: "callout--error",
};
---

<div class:list={["callout", variantClass[variant]]} role="note">
  <slot />
</div>

<style>
  /* ============================================
     Callout — GitHub Design Language
     ============================================ */

  .callout {
    position: relative;
    margin-block: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-inline-start: 3px solid #0969da;
    border-radius: 0 6px 6px 0;
    background-color: #f6f8fa;
    font-size: 0.875rem;
    line-height: 1.65;
    color: #656d76;
  }

  /* ============================================
     Variants
     ============================================ */

  .callout--default {
    border-inline-start-color: #0969da;
  }

  .callout--success {
    border-inline-start-color: #1a7f37;
  }

  .callout--warning {
    border-inline-start-color: #bf8700;
  }

  .callout--error {
    border-inline-start-color: #d1242f;
  }

  /* ============================================
     Content
     ============================================ */

  .callout :global(p) {
    margin: 0;
  }

  .callout :global(p + p) {
    margin-block-start: var(--space-2);
  }

  .callout :global(code) {
    font-size: 0.85em;
    background-color: #eff1f3;
    color: #24292f;
    padding: 0.12em 0.3em;
    border-radius: 6px;
  }
</style>
