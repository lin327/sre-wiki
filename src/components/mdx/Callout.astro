---
interface Props {
  /** Border accent color — maps to a design-system token. */
  variant?: "default" | "success" | "warning" | "error";
}

const { variant = "default" } = Astro.props;

const variantClass: Record<string, string> = {
  default: "callout--default",
  success: "callout--success",
  warning: "callout--warning",
  error: "callout--error",
};
---

<div class:list={["callout", variantClass[variant]]} role="note">
  <slot />
</div>

<style>
  /* ============================================
     Callout — Scoped Styles
     ============================================ */

  .callout {
    position: relative;
    margin-block: var(--space-4);
    padding: var(--space-3) var(--space-4);
    border-inline-start: 3px solid var(--color-info);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background-color: var(--color-surface);
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-muted);
    transition: border-color var(--motion-fast) ease;
  }

  .callout:hover {
    border-inline-start-color: var(--color-info);
    filter: brightness(1.04);
  }

  /* Inline glow pseudo — lighter than Admonition */
  .callout::before {
    content: "";
    position: absolute;
    inset-inline-start: -3px;
    inset-block: 0;
    width: 3px;
    border-radius: var(--radius-sm) 0 0 var(--radius-sm);
    background: var(--color-info);
    box-shadow: 0 0 6px oklch(from var(--color-info) l c h / 0.35);
    opacity: 0;
    transition: opacity var(--motion-fast) ease;
  }

  .callout:hover::before {
    opacity: 1;
  }

  /* ============================================
     Variants
     ============================================ */

  .callout--default {
    border-inline-start-color: var(--color-info);
  }

  .callout--default::before {
    background: var(--color-info);
    box-shadow: 0 0 6px oklch(from var(--color-info) l c h / 0.35);
  }

  .callout--success {
    border-inline-start-color: var(--color-success);
  }

  .callout--success::before {
    background: var(--color-success);
    box-shadow: 0 0 6px oklch(from var(--color-success) l c h / 0.35);
  }

  .callout--warning {
    border-inline-start-color: var(--color-warning);
  }

  .callout--warning::before {
    background: var(--color-warning);
    box-shadow: 0 0 6px oklch(from var(--color-warning) l c h / 0.35);
  }

  .callout--error {
    border-inline-start-color: var(--color-error);
  }

  .callout--error::before {
    background: var(--color-error);
    box-shadow: 0 0 6px oklch(from var(--color-error) l c h / 0.35);
  }

  /* ============================================
     Content
     ============================================ */

  .callout :global(p) {
    margin: 0;
  }

  .callout :global(p + p) {
    margin-block-start: var(--space-2);
  }

  .callout :global(code) {
    font-size: 0.85em;
    background-color: var(--color-code-bg);
    color: var(--color-code-text);
    padding: 0.12em 0.3em;
    border-radius: var(--radius-sm);
  }

  /* ============================================
     Reduced Motion
     ============================================ */

  @media (prefers-reduced-motion: reduce) {
    .callout {
      transition: none;
    }

    .callout::before {
      transition: none;
    }
  }
</style>
