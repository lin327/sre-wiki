---
interface Props {
  title: string;
  description?: string;
  href?: string;
  icon?: string;
}

const { title, description, href, icon } = Astro.props;

const Tag = href ? "a" : "div";
---

<Tag class="card" href={href}>
  {icon && <span class="card-icon" set:html={icon} />}
  <div class="card-content">
    <h3 class="card-title">{title}</h3>
    {description && <p class="card-description">{description}</p>}
  </div>
  {href && (
    <span class="card-arrow" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 12h14" />
        <path d="m12 5 7 7-7 7" />
      </svg>
    </span>
  )}
</Tag>

<style>
  /* ============================================
     Card — Scoped Styles
     ============================================ */

  .card {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid var(--color-surface-2);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    color: var(--color-ink);
    text-decoration: none;
    cursor: pointer;
    transition:
      transform var(--motion-normal) var(--ease-out-expo),
      border-color var(--motion-normal) var(--ease-out-expo),
      box-shadow var(--motion-normal) var(--ease-out-expo),
      background-color var(--motion-fast) ease;
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: var(--color-primary);
    box-shadow:
      0 8px 32px oklch(from var(--color-primary) l c h / 0.15),
      0 0 0 1px oklch(from var(--color-primary) l c h / 0.10);
    text-decoration: none;
  }

  .card:active {
    transform: translateY(-1px);
    transition-duration: var(--motion-fast);
  }

  /* ============================================
     Icon
     ============================================ */

  .card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md);
    background-color: var(--color-surface-2);
    color: var(--color-primary-l);
    transition: background-color var(--motion-fast) ease;
  }

  .card-icon :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .card:hover .card-icon {
    background-color: oklch(from var(--color-primary) l c h / 0.15);
  }

  /* ============================================
     Content
     ============================================ */

  .card-content {
    flex: 1;
    min-width: 0;
  }

  .card-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-ink);
    letter-spacing: -0.01em;
  }

  .card:hover .card-title {
    color: var(--color-primary-l);
  }

  .card-description {
    margin: var(--space-1) 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ============================================
     Arrow (link cards only)
     ============================================ */

  .card-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.5rem;
    height: 1.5rem;
    margin-block-start: 0.25rem;
    color: var(--color-dim);
    transition:
      color var(--motion-fast) ease,
      transform var(--motion-normal) var(--ease-out-expo);
  }

  .card:hover .card-arrow {
    color: var(--color-primary-l);
    transform: translateX(3px);
  }

  /* ============================================
     Focus Ring
     ============================================ */

  a.card:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* ============================================
     Reduced Motion
     ============================================ */

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card-icon,
    .card-arrow {
      transition: none;
    }

    .card:hover {
      transform: none;
    }

    .card:active {
      transform: none;
    }

    .card:hover .card-arrow {
      transform: none;
    }
  }
</style>
