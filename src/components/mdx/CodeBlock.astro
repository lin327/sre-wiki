---
interface Props {
  code?: string;
  class?: string;
}

const { code, class: className } = Astro.props;
---

<div class:list={["codeblock", className]} data-code={code}>
  <div class="codeblock-body">
    <slot />
  </div>
</div>

<style>
  /* =============================================
     CodeBlock — GitHub Design Language
     ============================================= */

  .codeblock {
    position: relative;
    margin-block: var(--space-6);
    border: 1px solid #d0d7de;
    border-radius: 6px;
    overflow: hidden;
    background: #f6f8fa;
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
  }

  /* =============================================
     Header Bar (filename + language + copy)
     ============================================= */

  :global(.codeblock-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    background: #f6f8fa;
    border-bottom: 1px solid #d0d7de;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif;
    font-size: 0.75rem;
    color: #656d76;
    user-select: none;
    -webkit-user-select: none;
  }

  :global(.codeblock-header-left) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  :global(.codeblock-filename) {
    font-weight: 600;
    color: #24292f;
  }

  :global(.codeblock-lang) {
    font-size: 0.7rem;
    color: #656d76;
    text-transform: lowercase;
  }

  /* =============================================
     Copy Button (visible on hover)
     ============================================= */

  :global(.codeblock-copy-btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.5rem;
    border: 1px solid #d0d7de;
    border-radius: 6px;
    background: #f6f8fa;
    color: #656d76;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif;
    font-size: 0.7rem;
    cursor: pointer;
    opacity: 0;
    transition: opacity 150ms ease, background-color 150ms ease, color 150ms ease;
  }

  :global(.codeblock-copy-btn:hover) {
    background: #eaeef2;
    color: #24292f;
  }

  :global(.codeblock-copy-btn:focus-visible) {
    opacity: 1;
    outline: 2px solid #0969da;
    outline-offset: -2px;
  }

  :global(.codeblock-copy-btn.is-copied) {
    color: #1a7f37;
    opacity: 1;
  }

  :global(.codeblock-copy-btn svg) {
    flex-shrink: 0;
  }

  :global(.codeblock-copy-btn .copy-check) {
    display: none;
  }

  :global(.codeblock-copy-btn.is-copied .copy-clipboard) {
    display: none;
  }

  :global(.codeblock-copy-btn.is-copied .copy-check) {
    display: block;
  }

  .codeblock:hover :global(.codeblock-copy-btn) {
    opacity: 1;
  }

  /* =============================================
     Code Area
     ============================================= */

  .codeblock-body {
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: thin;
    scrollbar-color: #afb8c1 transparent;
  }

  .codeblock-body::-webkit-scrollbar {
    height: 6px;
  }

  .codeblock-body::-webkit-scrollbar-thumb {
    background: #afb8c1;
    border-radius: 3px;
  }

  .codeblock-body::-webkit-scrollbar-thumb:hover {
    background: #8b949e;
  }

  :global(.codeblock-body pre) {
    margin: 0;
    padding: 1rem;
    background: transparent !important;
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
    font-size: 0.8125rem;
    line-height: 1.6;
    tab-size: 2;
    -moz-tab-size: 2;
    white-space: pre;
    min-width: 0;
  }

  :global(.codeblock-body pre code) {
    display: block;
    background: none;
    padding: 0;
    border-radius: 0;
    font-size: inherit;
    line-height: inherit;
    color: #24292f;
  }

  /* =============================================
     Line Numbers
     ============================================= */

  :global(.codeblock-lines) {
    display: flex;
    flex-direction: column;
    padding: 1rem 0;
    padding-right: 0.75rem;
    margin-right: 0;
    border-right: 1px solid #d0d7de;
    text-align: end;
    user-select: none;
    -webkit-user-select: none;
    flex-shrink: 0;
  }

  :global(.codeblock-line-num) {
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
    font-size: 0.75rem;
    line-height: 1.6;
    color: #656d76;
    min-width: 2.5ch;
    padding-inline: 0.75rem;
  }

  /* =============================================
     Syntax Color Overrides (Shiki inline style reset)
     ============================================= */

  :global(.codeblock-body .line span) {
    color: inherit !important;
  }

  :global(.codeblock-body .line .keyword) {
    color: #cf222e !important;
  }

  :global(.codeblock-body .line .string) {
    color: #0a3069 !important;
  }

  :global(.codeblock-body .line .comment) {
    color: #6e7781 !important;
    font-style: italic;
  }

  :global(.codeblock-body .line .number) {
    color: #0550ae !important;
  }

  :global(.codeblock-body .line .function) {
    color: #8250df !important;
  }

  /* =============================================
     Accessibility: reduced motion
     ============================================= */

  @media (prefers-reduced-motion: reduce) {
    :global(.codeblock-copy-btn) {
      transition: none;
    }
  }
</style>

<script>
  const LANG_LABELS: Record<string, string> = {
    bash: "shell",
    sh: "shell",
    zsh: "shell",
    shell: "shell",
    powershell: "powershell",
    ps1: "powershell",
    python: "python",
    py: "python",
    javascript: "javascript",
    js: "javascript",
    typescript: "typescript",
    ts: "typescript",
    jsx: "jsx",
    tsx: "tsx",
    html: "html",
    css: "css",
    scss: "scss",
    json: "json",
    yaml: "yaml",
    yml: "yaml",
    toml: "toml",
    xml: "xml",
    sql: "sql",
    rust: "rust",
    rs: "rust",
    go: "go",
    golang: "go",
    java: "java",
    c: "c",
    cpp: "c++",
    "c++": "c++",
    csharp: "c#",
    "c#": "c#",
    ruby: "ruby",
    rb: "ruby",
    php: "php",
    swift: "swift",
    kotlin: "kotlin",
    kt: "kotlin",
    dart: "dart",
    lua: "lua",
    r: "r",
    dockerfile: "dockerfile",
    docker: "dockerfile",
    diff: "diff",
    md: "markdown",
    markdown: "markdown",
    graphql: "graphql",
    gql: "graphql",
    terraform: "terraform",
    tf: "terraform",
    hcl: "hcl",
    makefile: "makefile",
    make: "makefile",
    nginx: "nginx",
    apache: "apache",
    txt: "text",
    text: "text",
    plaintext: "text",
  };

  function resolveLang(pre: HTMLElement, body: HTMLElement): string {
    const attr = pre.getAttribute("data-language");
    if (attr) return attr.toLowerCase();

    const cls = pre.className;
    const m = cls.match(/language-(\S+)/);
    if (m) return m[1].toLowerCase();

    const code = pre.querySelector("code");
    if (code) {
      const cm = code.className.match(/language-(\S+)/);
      if (cm) return cm[1].toLowerCase();
    }

    return "";
  }

  function langLabel(lang: string): string {
    if (!lang) return "";
    return LANG_LABELS[lang] ?? lang;
  }

  function buildHeader(
    lang: string,
    onCopy: () => void
  ): HTMLElement {
    const header = document.createElement("div");
    header.className = "codeblock-header";

    const left = document.createElement("div");
    left.className = "codeblock-header-left";

    if (lang) {
      const label = document.createElement("span");
      label.className = "codeblock-lang";
      label.textContent = langLabel(lang);
      left.appendChild(label);
    }

    header.appendChild(left);

    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "codeblock-copy-btn";
    btn.setAttribute("aria-label", "Copy code to clipboard");
    btn.innerHTML = `<svg class="copy-clipboard" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg><svg class="copy-check" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>`;
    btn.addEventListener("click", onCopy);
    header.appendChild(btn);

    return header;
  }

  function addLineNumbers(pre: HTMLElement): void {
    const code = pre.querySelector("code");
    if (!code) return;

    const lines = code.querySelectorAll<HTMLElement>(".line");
    if (lines.length < 2) return;

    const numWrap = document.createElement("div");
    numWrap.className = "codeblock-lines";
    numWrap.setAttribute("aria-hidden", "true");

    for (let i = 1; i <= lines.length; i++) {
      const num = document.createElement("span");
      num.className = "codeblock-line-num";
      num.textContent = String(i);
      numWrap.appendChild(num);
    }

    pre.insertBefore(numWrap, pre.firstChild);
  }

  function getPlainText(codeEl: HTMLElement): string {
    const lines = codeEl.querySelectorAll<HTMLElement>(".line");
    if (lines.length === 0) {
      return (codeEl.textContent || "").replace(/\n$/, "");
    }

    const parts: string[] = [];
    for (const line of lines) {
      let text = "";
      for (const child of Array.from(line.childNodes)) {
        if (
          child instanceof HTMLElement &&
          child.classList.contains("codeblock-line-num")
        ) {
          continue;
        }
        text += child.textContent || "";
      }
      parts.push(text);
    }
    return parts.join("\n");
  }

  function resetShikiColors(pre: HTMLElement): void {
    const lineSpans = pre.querySelectorAll<HTMLElement>(".line > span[style]");
    for (const span of lineSpans) {
      const style = span.getAttribute("style") || "";
      if (style.includes("color:")) {
        const cleaned = style
          .replace(/color:\s*[^;]+;?\s*/g, "")
          .trim();
        if (cleaned) {
          span.setAttribute("style", cleaned);
        } else {
          span.removeAttribute("style");
        }
      }
    }

    const code = pre.querySelector<HTMLElement>("code");
    if (code) {
      const style = code.getAttribute("style") || "";
      if (style.includes("color:")) {
        const cleaned = style
          .replace(/color:\s*[^;]+;?\s*/g, "")
          .trim();
        if (cleaned) {
          code.setAttribute("style", cleaned);
        } else {
          code.removeAttribute("style");
        }
      }
    }

    const preStyle = pre.getAttribute("style") || "";
    if (preStyle.includes("background-color:")) {
      const cleaned = preStyle
        .replace(/background-color:\s*[^;]+;?\s*/g, "")
        .trim();
      if (cleaned) {
        pre.setAttribute("style", cleaned);
      } else {
        pre.removeAttribute("style");
      }
    }
  }

  function initCodeBlocks(): void {
    const blocks = document.querySelectorAll<HTMLElement>(
      ".codeblock:not([data-initialized])"
    );

    for (const block of blocks) {
      block.dataset.initialized = "true";

      const body = block.querySelector<HTMLElement>(
        ".codeblock-body"
      );
      if (!body) continue;

      const pre = body.querySelector<HTMLElement>("pre");
      if (!pre) continue;

      const rawLang = resolveLang(pre, body);

      resetShikiColors(pre);

      pre.style.display = "flex";
      pre.style.alignItems = "flex-start";

      addLineNumbers(pre);

      const onCopy = async () => {
        const btn = block.querySelector<HTMLButtonElement>(
          ".codeblock-copy-btn"
        );
        if (!btn) return;

        const codeEl = pre.querySelector<HTMLElement>("code");
        const text =
          block.dataset.code ||
          (codeEl ? getPlainText(codeEl) : "");

        try {
          await navigator.clipboard.writeText(text);
          btn.classList.add("is-copied");

          setTimeout(() => {
            btn.classList.remove("is-copied");
          }, 2000);
        } catch {
          // silent
        }
      };

      const header = buildHeader(rawLang, onCopy);
      block.insertBefore(header, body);
    }
  }

  initCodeBlocks();
  document.addEventListener("astro:page-load", initCodeBlocks);
</script>
