---
import "../styles/design-system.css";
import ThemeToggle from "../components/react/ThemeToggle.tsx";
import PagefindSearch from "../components/react/PagefindSearch.tsx";
import TOC from "../components/astro/TOC.astro";
import LastModified from "../components/astro/LastModified.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  headings?: Heading[];
  updated?: string;
}

const {
  title = "SRE Atlas",
  description = "SRE 知识图谱与运维手册",
  headings = [],
  updated,
} = Astro.props;

const currentPath = Astro.url.pathname;

const topNavLinks = [
  { href: "/linux/process-model", label: "Linux" },
  { href: "/docker/image-layers", label: "Docker" },
  { href: "/kubernetes/pod-lifecycle", label: "Kubernetes" },
  { href: "/runbooks/crashloopbackoff", label: "Runbook" },
  { href: "/architectures/ha-cluster", label: "Architecture" },
  { href: "/incidents/etcd-data-corruption", label: "Incidents" },
  { href: "/comparisons/helm-vs-kustomize", label: "Comparisons" },
];

function isActive(href: string): boolean {
  return currentPath.startsWith(href.replace(/\/[^/]*$/, ""));
}
---

<!doctype html>
<html lang="zh" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | SRE Atlas</title>
  </head>
  <body>
    <!-- Top Navigation -->
    <nav class="topnav">
      <!-- Logo -->
      <a href="/" class="topnav__brand">
        <span class="topnav__dot"></span>
        SRE Atlas
      </a>

      <!-- Center: category links -->
      <div class="topnav__links">
        {topNavLinks.map((link) => (
          <a
            href={link.href}
            class:list={["topnav__link", { "topnav__link--active": isActive(link.href) }]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Right: theme + search -->
      <div class="topnav__right">
        <ThemeToggle client:load />
        <button id="search-trigger" class="topnav__search" aria-label="Search" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <span class="topnav__search-text">搜索…</span>
          <kbd class="topnav__kbd">Ctrl K</kbd>
        </button>
      </div>

      <!-- Mobile hamburger -->
      <button id="mobile-menu-toggle" class="topnav__hamburger" aria-label="Menu" aria-expanded="false" type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" x2="20" y1="12" y2="12"></line>
          <line x1="4" x2="20" y1="6" y2="6"></line>
          <line x1="4" x2="20" y1="18" y2="18"></line>
        </svg>
      </button>
    </nav>

    <!-- Mobile dropdown -->
    <div id="mobile-menu" class="mobile-menu" hidden>
      {topNavLinks.map((link) => (
        <a
          href={link.href}
          class:list={["mobile-menu__link", { "mobile-menu__link--active": isActive(link.href) }]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <!-- Pagefind Search -->
    <PagefindSearch client:idle />

    <!-- Layout -->
    <div class="atlas-layout">
      <main class="atlas-main">
        <article class="prose">
          <slot />
          {updated && <LastModified date={updated} />}
        </article>
      </main>

      {headings.length > 0 && (
        <aside class="atlas-toc" aria-label="Table of contents">
          <div class="atlas-toc__inner">
            <p class="atlas-toc__title">On this page</p>
            <TOC headings={headings} />
          </div>
        </aside>
      )}
    </div>

    <style>
      /* ========== Top Navigation ========== */
      .topnav {
        position: sticky;
        top: 0;
        z-index: 100;
        height: 52px;
        display: flex;
        align-items: center;
        padding: 0 20px;
        background: var(--color-surface);
        border-bottom: 1px solid var(--color-surface-2);
        box-shadow: 0 1px 2px oklch(0 0 0 / 0.05);
      }

      .topnav__brand {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 15px;
        font-weight: 700;
        color: var(--color-accent);
        white-space: nowrap;
        text-decoration: none;
        flex-shrink: 0;
        margin-right: 32px;
      }
      .topnav__brand:hover { opacity: 0.85; }

      .topnav__dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--color-accent);
        flex-shrink: 0;
      }

      .topnav__links {
        display: none;
        gap: 4px;
        align-items: center;
        flex: 1;
        justify-content: center;
      }
      @media (min-width: 768px) {
        .topnav__links { display: flex; }
      }

      .topnav__link {
        padding: 5px 14px;
        border-radius: var(--radius-sm);
        font-size: 12px;
        color: var(--color-muted);
        text-decoration: none;
        transition: background var(--motion-fast) ease, color var(--motion-fast) ease;
        white-space: nowrap;
      }
      .topnav__link:hover {
        background: var(--color-surface-2);
        color: var(--color-ink);
      }
      .topnav__link--active {
        background: oklch(0.550 0.105 230.0 / 0.12);
        color: var(--color-accent);
        font-weight: 600;
      }

      .topnav__right {
        display: none;
        align-items: center;
        gap: 8px;
        margin-left: auto;
      }
      @media (min-width: 768px) {
        .topnav__right { display: flex; }
      }

      .topnav__search {
        display: flex;
        align-items: center;
        gap: 6px;
        height: 32px;
        padding: 0 10px 0 10px;
        border: 1px solid var(--color-surface-2);
        border-radius: var(--radius-sm);
        background: var(--color-surface-2);
        color: var(--color-dim);
        font-size: 12px;
        cursor: pointer;
        transition: border-color var(--motion-fast) ease, background var(--motion-fast) ease;
      }
      .topnav__search:hover {
        border-color: var(--color-accent);
        background: var(--color-surface);
      }

      .topnav__search-text { white-space: nowrap; }

      .topnav__kbd {
        padding: 1px 5px;
        border-radius: 3px;
        border: 1px solid var(--color-surface-3);
        background: var(--color-bg);
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--color-dim);
        pointer-events: none;
        line-height: 1.4;
      }

      /* Mobile hamburger */
      .topnav__hamburger {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        margin-left: auto;
        border-radius: var(--radius-sm);
        color: var(--color-muted);
        transition: color var(--motion-fast) ease;
      }
      .topnav__hamburger:hover { color: var(--color-ink); }
      @media (min-width: 768px) { .topnav__hamburger { display: none; } }

      /* Mobile dropdown */
      .mobile-menu {
        position: fixed;
        top: 52px;
        left: 0;
        right: 0;
        z-index: 99;
        background: var(--color-surface);
        border-bottom: 1px solid var(--color-surface-2);
        padding: 8px 12px;
        display: flex;
        flex-direction: column;
        gap: 2px;
        box-shadow: 0 4px 12px oklch(0 0 0 / 0.15);
      }

      .mobile-menu__link {
        padding: 8px 12px;
        border-radius: var(--radius-sm);
        font-size: 13px;
        color: var(--color-muted);
        text-decoration: none;
        transition: background var(--motion-fast) ease, color var(--motion-fast) ease;
      }
      .mobile-menu__link:hover {
        background: var(--color-surface-2);
        color: var(--color-ink);
      }
      .mobile-menu__link--active {
        background: oklch(0.550 0.105 230.0 / 0.12);
        color: var(--color-accent);
        font-weight: 600;
      }

      /* ========== Layout ========== */
      .atlas-layout {
        display: flex;
        min-height: calc(100vh - 52px);
      }

      .atlas-main {
        flex: 1;
        min-width: 0;
        padding: 2rem 1.5rem;
        overflow-x: hidden;
      }
      @media (min-width: 768px) { .atlas-main { padding: 2.5rem 3rem; } }
      @media (min-width: 1280px) { .atlas-main { padding: 2.5rem 4rem; } }

      /* TOC */
      .atlas-toc {
        display: none;
        width: 14rem;
        flex-shrink: 0;
        overflow-y: auto;
        border-left: 1px solid var(--color-surface-2);
        padding: 1rem;
      }
      @media (min-width: 1280px) { .atlas-toc { display: block; } }

      .atlas-toc__inner { position: sticky; top: 2rem; }
      .atlas-toc__title {
        margin-bottom: 0.75rem;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-dim);
      }
    </style>

    <script>
      // Mobile menu
      const menuToggle = document.getElementById("mobile-menu-toggle");
      const mobileMenu = document.getElementById("mobile-menu");
      menuToggle?.addEventListener("click", () => {
        const expanded = menuToggle.getAttribute("aria-expanded") === "true";
        menuToggle.setAttribute("aria-expanded", String(!expanded));
        if (mobileMenu) mobileMenu.hidden = expanded;
      });
      // Close on navigation
      mobileMenu?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          if (mobileMenu) mobileMenu.hidden = true;
          menuToggle?.setAttribute("aria-expanded", "false");
        });
      });
      // Close on Escape
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && mobileMenu && !mobileMenu.hidden) {
          mobileMenu.hidden = true;
          menuToggle?.setAttribute("aria-expanded", "false");
        }
      });

      // Search trigger
      document.getElementById("search-trigger")?.addEventListener("click", () => {
        window.dispatchEvent(new KeyboardEvent("keydown", { key: "k", ctrlKey: true, bubbles: true }));
      });
    </script>
  </body>
</html>
