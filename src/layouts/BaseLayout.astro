---
import "../styles/design-system.css";
import ThemeToggle from "../components/react/ThemeToggle.tsx";
import PagefindSearch from "../components/react/PagefindSearch.tsx";
import TOC from "../components/astro/TOC.astro";
import LastModified from "../components/astro/LastModified.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  headings?: Heading[];
  updated?: string;
}

const {
  title = "SRE Atlas",
  description = "SRE 知识图谱与运维手册",
  headings = [],
  updated,
} = Astro.props;

const currentPath = Astro.url.pathname;

const topNavLinks = [
  { href: "/linux/process-model", label: "Linux" },
  { href: "/docker/image-layers", label: "Docker" },
  { href: "/kubernetes/pod-lifecycle", label: "Kubernetes" },
  { href: "/runbooks/crashloopbackoff", label: "Runbook" },
  { href: "/architectures/ha-cluster", label: "Architecture" },
  { href: "/incidents/etcd-data-corruption", label: "Incidents" },
  { href: "/comparisons/helm-vs-kustomize", label: "Comparisons" },
];

function isActive(href: string): boolean {
  return currentPath.startsWith(href.replace(/\/[^/]*$/, ""));
}
---

<!doctype html>
<html lang="zh" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="view-transition" content="same-origin" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | SRE Atlas</title>
  </head>
  <body>
    <!-- Scroll Progress Bar -->
    <div id="scroll-progress" class="scroll-progress" aria-hidden="true"></div>

    <!-- Top Navigation -->
    <nav class="topnav" id="topnav">
      <!-- Logo -->
      <a href="/" class="topnav__brand">
        <span class="topnav__dot" aria-hidden="true"></span>
        SRE Atlas
      </a>

      <!-- Center: category links -->
      <div class="topnav__links">
        {topNavLinks.map((link) => (
          <a
            href={link.href}
            class:list={["topnav__link", { "topnav__link--active": isActive(link.href) }]}
          >
            {link.label}
            {isActive(link.href) && <span class="topnav__link-indicator" aria-hidden="true"></span>}
          </a>
        ))}
      </div>

      <!-- Right: theme + search -->
      <div class="topnav__right">
        <ThemeToggle client:load />
        <button id="search-trigger" class="topnav__search" aria-label="Search" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <span class="topnav__search-text">搜索…</span>
          <kbd class="topnav__kbd">Ctrl K</kbd>
        </button>
      </div>

    </nav>

    <!-- Pagefind Search -->
    <PagefindSearch client:idle />

    <!-- Layout -->
    <div class="atlas-layout">
      <main class="atlas-main" id="atlas-main">
        <article class="prose">
          <slot />
          {updated && <LastModified date={updated} />}
        </article>
      </main>

      {headings.length > 0 && (
        <aside class="atlas-toc" aria-label="Table of contents">
          <div class="atlas-toc__inner">
            <p class="atlas-toc__title">On this page</p>
            <TOC headings={headings} />
          </div>
        </aside>
      )}
    </div>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="site-footer__inner">
        <p class="site-footer__brand">SRE Atlas · Powered by Astro</p>
        <p class="site-footer__sub">Built with OKLCH design system</p>
        <a
          href="https://github.com"
          class="site-footer__link"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub repository"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
      </div>
    </footer>

    <!-- Keyboard Shortcuts Button -->
    <button id="shortcuts-trigger" class="shortcuts-btn" aria-label="Keyboard shortcuts" type="button">
      ?
    </button>

    <!-- Keyboard Shortcuts Overlay -->
    <div id="shortcuts-overlay" class="shortcuts-overlay" hidden>
      <div class="shortcuts-dialog" role="dialog" aria-label="Keyboard shortcuts">
        <div class="shortcuts-dialog__header">
          <h3 class="shortcuts-dialog__title">Keyboard Shortcuts</h3>
          <button id="shortcuts-close" class="shortcuts-dialog__close" aria-label="Close" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" x2="6" y1="6" y2="18"></line>
              <line x1="6" x2="18" y1="6" y2="18"></line>
            </svg>
          </button>
        </div>
        <ul class="shortcuts-dialog__list">
          <li class="shortcuts-dialog__item">
            <span class="shortcuts-dialog__desc">Search</span>
            <kbd class="shortcuts-dialog__kbd">Ctrl</kbd><span class="shortcuts-dialog__plus">+</span><kbd class="shortcuts-dialog__kbd">K</kbd>
          </li>
          <li class="shortcuts-dialog__item">
            <span class="shortcuts-dialog__desc">Close dialogs</span>
            <kbd class="shortcuts-dialog__kbd">Esc</kbd>
          </li>
          <li class="shortcuts-dialog__item">
            <span class="shortcuts-dialog__desc">Show this help</span>
            <kbd class="shortcuts-dialog__kbd">?</kbd>
          </li>
        </ul>
      </div>
    </div>

    <style>
      @media (prefers-reduced-motion: no-preference) {
        ::view-transition-old(root) {
          animation: vt-fade-out 200ms ease-out both;
        }
        ::view-transition-new(root) {
          animation: vt-fade-in 250ms ease-in both;
        }
      }

      @keyframes vt-fade-out {
        from { opacity: 1; transform: translateY(0); }
        to   { opacity: 0; transform: translateY(-6px); }
      }
      @keyframes vt-fade-in {
        from { opacity: 0; transform: translateY(6px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      /* Scroll Progress */
      .scroll-progress {
        position: fixed;
        top: 0;
        left: 0;
        z-index: var(--z-sticky);
        width: 0%;
        height: 2px;
        background: linear-gradient(90deg, var(--color-primary), var(--color-accent));
        transition: width 50ms linear;
        pointer-events: none;
      }

      /* Top Navigation */
      .topnav {
        position: sticky;
        top: 0;
        z-index: var(--z-sticky);
        height: 52px;
        display: flex;
        align-items: center;
        padding: 0 20px;
        background: var(--color-surface);
        border-bottom: 1px solid var(--color-surface-2);
        box-shadow: 0 1px 2px oklch(0 0 0 / 0.05);
        transition: background var(--motion-normal) ease,
                    box-shadow var(--motion-normal) ease,
                    backdrop-filter var(--motion-normal) ease;
      }
      .topnav--scrolled {
        background: oklch(from var(--color-surface) l c h / 0.82);
        backdrop-filter: blur(12px) saturate(1.4);
        -webkit-backdrop-filter: blur(12px) saturate(1.4);
        box-shadow: 0 1px 8px oklch(0 0 0 / 0.12);
      }

      .topnav__brand {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 15px;
        font-weight: 700;
        color: var(--color-accent);
        white-space: nowrap;
        text-decoration: none;
        flex-shrink: 0;
        margin-right: 32px;
      }
      .topnav__brand:hover { opacity: 0.85; }

      .topnav__dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--color-accent);
        flex-shrink: 0;
        animation: dot-pulse 3s ease-in-out infinite;
      }
      @keyframes dot-pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50%      { opacity: 0.55; transform: scale(0.8); }
      }

      .topnav__links {
        display: none;
        gap: 4px;
        align-items: center;
        flex: 1;
        justify-content: center;
      }
      @media (min-width: 768px) {
        .topnav__links { display: flex; }
      }

      .topnav__link {
        position: relative;
        padding: 5px 14px;
        border-radius: var(--radius-sm);
        font-size: 12px;
        color: var(--color-muted);
        text-decoration: none;
        transition: background var(--motion-fast) ease, color var(--motion-fast) ease;
        white-space: nowrap;
      }
      .topnav__link:hover {
        background: var(--color-surface-2);
        color: var(--color-ink);
      }
      .topnav__link--active {
        background: oklch(0.550 0.105 230.0 / 0.12);
        color: var(--color-accent);
        font-weight: 600;
      }

      /* Animated underline indicator for active link */
      .topnav__link-indicator {
        position: absolute;
        bottom: -1px;
        left: 50%;
        transform: translateX(-50%);
        width: 0;
        height: 2px;
        border-radius: 1px;
        background: var(--color-accent);
        animation: underline-grow 300ms var(--ease-out-expo) forwards;
      }
      @keyframes underline-grow {
        from { width: 0; }
        to   { width: 60%; }
      }

      .topnav__right {
        display: none;
        align-items: center;
        gap: 8px;
        margin-left: auto;
      }
      @media (min-width: 768px) {
        .topnav__right { display: flex; }
      }

      .topnav__search {
        display: flex;
        align-items: center;
        gap: 6px;
        height: 32px;
        padding: 0 10px 0 10px;
        border: 1px solid var(--color-surface-2);
        border-radius: var(--radius-sm);
        background: var(--color-surface-2);
        color: var(--color-dim);
        font-size: 12px;
        cursor: pointer;
        transition: border-color var(--motion-fast) ease,
                    background var(--motion-fast) ease,
                    box-shadow var(--motion-normal) ease;
      }
      .topnav__search:hover {
        border-color: var(--color-accent);
        background: var(--color-surface);
        box-shadow: 0 0 12px oklch(from var(--color-accent) l c h / 0.25),
                    0 0 4px oklch(from var(--color-accent) l c h / 0.15);
      }

      .topnav__search-text { white-space: nowrap; }

      .topnav__kbd {
        padding: 1px 5px;
        border-radius: 3px;
        border: 1px solid var(--color-surface-3);
        background: var(--color-bg);
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--color-dim);
        pointer-events: none;
        line-height: 1.4;
      }

      /* Layout */
      .atlas-layout {
        display: flex;
        min-height: calc(100vh - 52px);
      }
      .atlas-main {
        flex: 1;
        min-width: 0;
        padding: 2rem 1.5rem;
        overflow-x: hidden;
        opacity: 0;
        animation: content-fade-in 500ms var(--ease-out-expo) 80ms forwards;
      }
      @keyframes content-fade-in {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      @media (min-width: 768px) { .atlas-main { padding: 2.5rem 3rem; } }
      @media (min-width: 1280px) { .atlas-main { padding: 2.5rem 4rem; } }
      /* Content links: underline slides from left */
      .prose :global(a:not(.topnav__link):not(.topnav__brand):not(.toc__link):not(.site-footer__link):not(.topnav__search)) {
        position: relative;
        text-decoration: none;
        background-image: linear-gradient(var(--color-primary-l), var(--color-primary-l));
        background-size: 0% 1px;
        background-position: 0 100%;
        background-repeat: no-repeat;
        transition: background-size var(--motion-normal) var(--ease-out-expo);
      }
      .prose :global(a:not(.topnav__link):not(.topnav__brand):not(.toc__link):not(.site-footer__link):not(.topnav__search):hover) {
        background-size: 100% 1px;
      }

      /* Heading border reveal */
      .prose :global(h2),
      .prose :global(h3) {
        position: relative;
        border-left: 3px solid transparent;
        padding-left: 0;
        transition: border-color var(--motion-slow) var(--ease-out-expo),
                    padding-left var(--motion-slow) var(--ease-out-expo);
      }
      .prose :global(h2.heading-visible),
      .prose :global(h3.heading-visible) {
        border-left-color: var(--color-accent);
        padding-left: var(--space-3);
      }

      /* TOC */
      .atlas-toc {
        display: none;
        width: 14rem;
        flex-shrink: 0;
        overflow-y: auto;
        border-left: 1px solid var(--color-surface-2);
        padding: 1rem;
      }
      @media (min-width: 1280px) { .atlas-toc { display: block; } }

      .atlas-toc__inner { position: sticky; top: 2rem; }
      .atlas-toc__title {
        margin-bottom: 0.75rem;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-dim);
      }

      /* TOC active transitions via :global for child component */
      :global(.toc__link) {
        transition: color var(--motion-normal) ease,
                    border-color var(--motion-normal) var(--ease-out-expo),
                    background-color var(--motion-normal) ease !important;
      }
      :global(.toc__link--active) {
        background-color: oklch(from var(--color-accent) l c h / 0.06);
      }

      /* Footer */
      .site-footer {
        border-top: 1px solid var(--color-surface-2);
        padding: var(--space-8) var(--space-6);
      }
      .site-footer__inner {
        max-width: 75ch;
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2) var(--space-4);
      }
      .site-footer__brand {
        font-size: 0.8125rem;
        color: var(--color-muted);
        margin: 0;
      }
      .site-footer__sub {
        font-size: 0.75rem;
        color: var(--color-dim);
        margin: 0;
      }
      .site-footer__link {
        display: inline-flex;
        align-items: center;
        color: var(--color-dim);
        transition: color var(--motion-fast) ease;
        margin-left: auto;
      }
      .site-footer__link:hover {
        color: var(--color-accent);
      }

      /* Keyboard Shortcuts */
      .shortcuts-btn {
        position: fixed;
        bottom: 20px;
        right: 20px;
        z-index: var(--z-dropdown);
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 1px solid var(--color-surface-3);
        background: var(--color-surface);
        color: var(--color-dim);
        font-family: var(--font-mono);
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: border-color var(--motion-fast) ease,
                    color var(--motion-fast) ease,
                    box-shadow var(--motion-normal) ease;
        opacity: 0;
        animation: shortcuts-appear 400ms ease 1.2s forwards;
      }
      @keyframes shortcuts-appear {
        from { opacity: 0; transform: scale(0.85); }
        to   { opacity: 1; transform: scale(1); }
      }
      .shortcuts-btn:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
        box-shadow: 0 0 10px oklch(from var(--color-accent) l c h / 0.2);
      }

      .shortcuts-overlay {
        position: fixed;
        inset: 0;
        z-index: var(--z-overlay);
        background: oklch(0 0 0 / 0.5);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
        animation: overlay-in 200ms ease;
      }
      .shortcuts-overlay[hidden] { display: none; }
      @keyframes overlay-in {
        from { opacity: 0; }
        to   { opacity: 1; }
      }

      .shortcuts-dialog {
        background: var(--color-surface);
        border: 1px solid var(--color-surface-2);
        border-radius: var(--radius-xl);
        padding: var(--space-6);
        width: min(380px, 90vw);
        box-shadow: 0 16px 48px oklch(0 0 0 / 0.3);
        animation: dialog-in 250ms var(--ease-out-expo);
      }
      @keyframes dialog-in {
        from { opacity: 0; transform: translateY(12px) scale(0.97); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
      }

      .shortcuts-dialog__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: var(--space-5);
      }
      .shortcuts-dialog__title {
        font-size: 0.9375rem;
        font-weight: 600;
        color: var(--color-ink);
        margin: 0;
      }
      .shortcuts-dialog__close {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: var(--radius-sm);
        color: var(--color-dim);
        transition: background var(--motion-fast) ease, color var(--motion-fast) ease;
      }
      .shortcuts-dialog__close:hover {
        background: var(--color-surface-2);
        color: var(--color-ink);
      }

      .shortcuts-dialog__list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
      }
      .shortcuts-dialog__item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
      }
      .shortcuts-dialog__desc {
        font-size: 0.8125rem;
        color: var(--color-muted);
      }
      .shortcuts-dialog__kbd {
        display: inline-block;
        padding: 2px 7px;
        border-radius: 4px;
        border: 1px solid var(--color-surface-3);
        background: var(--color-bg);
        font-family: var(--font-mono);
        font-size: 0.6875rem;
        color: var(--color-dim);
        line-height: 1.6;
      }
      .shortcuts-dialog__plus {
        font-size: 0.6875rem;
        color: var(--color-dim);
        margin: 0 2px;
      }

      /* Reduced motion */
      @media (prefers-reduced-motion: reduce) {
        .scroll-progress { transition: none; }
        .topnav__dot { animation: none; }
        .topnav__link-indicator { animation: none; width: 60%; }
        .atlas-main { animation: none; opacity: 1; }
        .prose :global(h2),
        .prose :global(h3) { transition: none; }
        .shortcuts-btn { animation: none; opacity: 1; }
        .shortcuts-overlay,
        .shortcuts-dialog { animation: none; }
      }
    </style>

    <script>
      // === Search trigger ===
      document.getElementById("search-trigger")?.addEventListener("click", () => {
        window.dispatchEvent(new KeyboardEvent("keydown", { key: "k", ctrlKey: true, bubbles: true }));
      });

      // === Header backdrop-blur on scroll ===
      const topnav = document.getElementById("topnav");
      if (topnav) {
        const scrollThreshold = 10;
        let ticking = false;
        function onScroll() {
          if (!ticking) {
            requestAnimationFrame(() => {
              topnav.classList.toggle("topnav--scrolled", window.scrollY > scrollThreshold);
              ticking = false;
            });
            ticking = true;
          }
        }
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
      }

      // === Scroll progress bar ===
      const progressBar = document.getElementById("scroll-progress");
      if (progressBar) {
        let progressTicking = false;
        function updateProgress() {
          if (!progressTicking) {
            requestAnimationFrame(() => {
              const scrollTop = window.scrollY;
              const docHeight = document.documentElement.scrollHeight - window.innerHeight;
              const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
              progressBar.style.width = pct + "%";
              progressTicking = false;
            });
            progressTicking = true;
          }
        }
        window.addEventListener("scroll", updateProgress, { passive: true });
        updateProgress();
      }

      // === Heading border reveal on scroll ===
      function initHeadingReveal() {
        const headings = document.querySelectorAll<HTMLElement>(".prose h2, .prose h3");
        if (!headings.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("heading-visible");
              }
            }
          },
          { rootMargin: "-40px 0px -60% 0px", threshold: 0 }
        );

        headings.forEach((h) => observer.observe(h));

        document.addEventListener("astro:before-swap", () => observer.disconnect(), { once: true });
      }
      initHeadingReveal();
      document.addEventListener("astro:after-swap", initHeadingReveal);

      // === Keyboard shortcuts overlay ===
      const shortcutsTrigger = document.getElementById("shortcuts-trigger");
      const shortcutsOverlay = document.getElementById("shortcuts-overlay");
      const shortcutsClose = document.getElementById("shortcuts-close");

      function openShortcuts() {
        if (shortcutsOverlay) shortcutsOverlay.hidden = false;
      }
      function closeShortcuts() {
        if (shortcutsOverlay) shortcutsOverlay.hidden = true;
      }

      shortcutsTrigger?.addEventListener("click", openShortcuts);
      shortcutsClose?.addEventListener("click", closeShortcuts);
      shortcutsOverlay?.addEventListener("click", (e) => {
        if (e.target === shortcutsOverlay) closeShortcuts();
      });

      document.addEventListener("keydown", (e) => {
        // "?" to open shortcuts (when not in an input)
        if (
          e.key === "?" &&
          !e.ctrlKey &&
          !e.metaKey &&
          !e.altKey &&
          !(e.target instanceof HTMLInputElement) &&
          !(e.target instanceof HTMLTextAreaElement) &&
          !(e.target instanceof HTMLSelectElement)
        ) {
          e.preventDefault();
          openShortcuts();
        }
        // Esc to close shortcuts
        if (e.key === "Escape" && shortcutsOverlay && !shortcutsOverlay.hidden) {
          closeShortcuts();
        }
      });
    </script>
  </body>
</html>
