---
import "../styles/design-system.css";
import "../styles/components.css";
import ThemeToggle from "../components/react/ThemeToggle.tsx";
import PagefindSearch from "../components/react/PagefindSearch.tsx";
import AuthButton from "../components/react/AuthButton.tsx";
import LanguageSwitcher from "../components/react/LanguageSwitcher.tsx";
import TOC from "../components/astro/TOC.astro";
import LastModified from "../components/astro/LastModified.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  headings?: Heading[];
  updated?: string;
}

const {
  title = "SRE Atlas",
  description = "SRE 知识图谱与运维手册",
  headings = [],
  updated,
} = Astro.props;

const currentPath = Astro.url.pathname;
const isHome = currentPath === "/";
const isEnglish = currentPath.startsWith("/en/");
const lang = isEnglish ? "en" : "zh";

const topNavLinks = [
  { href: "/linux/process-model", label: "Linux",
    href: "/linux" },
  { href: "/docker/image-layers", label: "Docker",
    href: "/docker" },
  { href: "/kubernetes/pod-lifecycle", label: "Kubernetes",
    href: "/kubernetes" },
  { href: "/runbooks/crashloopbackoff", label: "Runbook" },
  { href: "/architectures/ha-cluster", label: "Architecture",
    href: "/architectures" },
  { href: "/incidents/etcd-data-corruption", label: "Incidents",
    href: "/incidents" },
  { href: "/comparisons/helm-vs-kustomize", label: "Comparisons",
    href: "/comparisons" },
];

/* Sidebar page groups — i18n aware */
const viewAll = isEnglish ? "View all" : "查看全部";
const sidebarGroups = [
  {
    label: "Linux",
    href: "/linux",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2Zm2 .5v11a.5.5 0 0 0 .5.5h11a.5.5 0 0 0 .5-.5v-11a.5.5 0 0 0-.5-.5h-11a.5.5 0 0 0-.5.5ZM4 5h8v1H4V5Zm0 3h6v1H4V8Z"/></svg>`,
    pages: [
      { href: "/linux/process-model", label: isEnglish ? "Process Model" : "进程模型" },
      { href: "/linux/filesystem", label: isEnglish ? "Filesystem" : "文件系统" },
      { href: "/linux/network-stack", label: isEnglish ? "Network Stack" : "网络栈" },
      { href: "/linux/systemd", label: "systemd" },
      { href: "/linux", label: `${viewAll} (355)` },
    ],
  },
  {
    label: "Docker",
    href: "/docker",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M13.02 7.222c-.012-.06-.028-.118-.046-.176l.003.012c-.088-.44-.39-.81-.81-1.047a1.7 1.7 0 0 0-.846-.21H9.13c-.16-.6-.45-1.13-.84-1.55C7.46 3.43 6.34 3 5.14 3c-.8 0-1.58.2-2.12.55A2.16 2.16 0 0 0 2 5.5c0 .4.1.78.32 1.12.2.3.48.54.8.7-.04.06-.07.14-.1.2C2.35 7.87 2 8.48 2 9.22c0 1.26.75 2.28 2.12 2.85.97.4 2.17.58 3.38.58.4 0 .8-.02 1.18-.07.48-.06.93-.18 1.34-.36.65-.29 1.18-.74 1.55-1.3.17-.25.3-.52.38-.8.14-.02.28-.06.4-.1.35-.13.64-.32.86-.57.2-.22.35-.5.44-.8.06-.2.1-.4.1-.62 0-.28-.06-.54-.16-.78a1.7 1.7 0 0 0-.4-.58c.08-.16.14-.34.18-.52.06-.2.08-.58.04-.88ZM3 6.5c0-.46.2-.86.52-1.14.3-.26.68-.36 1.02-.36.46 0 .92.16 1.3.44.3.24.52.56.62.92H3Zm3.38 5.44c-.78 0-1.58-.1-2.3-.34-1.06-.34-1.5-.86-1.5-1.58 0-.44.16-.82.44-1.12.28-.3.64-.48 1.08-.56.2-.04.42-.06.64-.08h5.88c-.12.44-.34.84-.66 1.16-.4.4-.9.66-1.46.78-.34.08-.7.12-1.06.12l-1.6.02ZM14 5.5h-1.5V4h-1v1.5H10v1h1.5V8h1V6.5H14v-1Z"/></svg>`,
    pages: [
      { href: "/docker/image-layers", label: isEnglish ? "Image Layers" : "镜像分层" },
      { href: "/docker/networking", label: isEnglish ? "Networking" : "网络模式" },
      { href: "/docker/storage", label: isEnglish ? "Storage Drivers" : "存储驱动" },
      { href: "/docker/compose", label: "Compose" },
      { href: "/docker", label: `${viewAll} (20)` },
    ],
  },
  {
    label: "Kubernetes",
    href: "/kubernetes",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0Zm3.67 11.36-4.67 2.7a.5.5 0 0 1-.5 0l-4.67-2.7a.5.5 0 0 1-.25-.43V5.07a.5.5 0 0 1 .25-.43l4.67-2.7a.5.5 0 0 1 .5 0l4.67 2.7a.5.5 0 0 1 .25.43v5.86a.5.5 0 0 1-.25.43ZM8 1.4 3.8 3.8v6.4L8 12.6l4.2-2.4V3.8L8 1.4Z"/><path d="M8 5a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm0 1a2 2 0 1 1 0 4 2 2 0 0 1 0-4Z"/></svg>`,
    pages: [
      { href: "/kubernetes/pod-lifecycle", label: isEnglish ? "Pod Lifecycle" : "Pod 生命周期" },
      { href: "/kubernetes/container-runtime", label: isEnglish ? "Container Runtime" : "容器运行时" },
      { href: "/kubernetes/service-mesh", label: "Service Mesh" },
      { href: "/kubernetes", label: `${viewAll} (65)` },
    ],
  },
  {
    label: "Runbooks",
    href: "/runbooks",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.5a.5.5 0 0 1 .5.5v5.793l2.146-2.147a.5.5 0 0 1 .708.708l-3 3a.5.5 0 0 1-.708 0l-3-3a.5.5 0 1 1 .708-.708L7.5 7.793V2a.5.5 0 0 1 .5-.5Z"/><path d="M2 12.5a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5Z"/></svg>`,
    pages: [
      { href: "/runbooks/crashloopbackoff", label: "CrashLoopBackOff" },
      { href: "/runbooks/oomkilled", label: "OOMKilled" },
      { href: "/runbooks/imagepullbackoff", label: "ImagePullBackOff" },
      { href: "/runbooks", label: `${viewAll} (50)` },
    ],
  },
  {
    label: "Architecture",
    href: "/architectures",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M6 1a1 1 0 0 0-1 1v2H3a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V8h2a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1h-2V2a1 1 0 0 0-1-1H6Zm0 1h4v2h2v2h-2v4H8V6H6V4h2V2Z"/></svg>`,
    pages: [
      { href: "/architectures/ha-cluster", label: isEnglish ? "HA Cluster" : "高可用集群" },
      { href: "/architectures/gitops-pipeline", label: "GitOps Pipeline" },
      { href: "/architectures", label: `${viewAll} (15)` },
    ],
  },
  {
    label: "Incidents",
    href: "/incidents",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566ZM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5Zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z"/></svg>`,
    pages: [
      { href: "/incidents/etcd-data-corruption", label: isEnglish ? "etcd Data Corruption" : "etcd 数据损坏" },
      { href: "/incidents/dns-resolution-failure", label: isEnglish ? "DNS Resolution Failure" : "DNS 解析故障" },
      { href: "/incidents", label: `${viewAll} (29)` },
    ],
  },
  {
    label: "Comparisons",
    href: "/comparisons",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M6 12.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5ZM3 8.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5Zm0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5Z"/></svg>`,
    pages: [
      { href: "/comparisons/helm-vs-kustomize", label: "Helm vs Kustomize" },
      { href: "/comparisons/istio-vs-linkerd", label: "Istio vs Linkerd" },
      { href: "/comparisons", label: `${viewAll} (2)` },
    ],
  },
];

function isActive(href: string): boolean {
  return currentPath.startsWith(href.replace(/\/[^\/]*$/, ""));
}

function isPageActive(href: string): boolean {
  return currentPath === href || currentPath === href + "/";
}
---

<!doctype html>
<html lang={lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="view-transition" content="same-origin" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Preload critical fonts */}
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title} | SRE Atlas</title>
  </head>
  <body>
    <!-- Skip to content link for keyboard/screen reader users -->
    <a href="#atlas-main" class="skip-link">{isEnglish ? "Skip to content" : "跳转到内容"}</a>

    <!-- Scroll Progress Bar -->
    <div id="scroll-progress" class="scroll-progress" aria-hidden="true"></div>

    <!-- Top Navigation -->
    <nav class="topnav" id="topnav">
      <!-- Left: menu + logo -->
      <div class="topnav__left">
        <button id="sidebar-toggle" class="topnav__menu" aria-label="Toggle menu" aria-expanded="false" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" x2="21" y1="6" y2="6"></line>
            <line x1="3" x2="21" y1="12" y2="12"></line>
            <line x1="3" x2="21" y1="18" y2="18"></line>
          </svg>
        </button>
        <a href="/" class="topnav__brand">
          <span class="topnav__dot" aria-hidden="true"></span>
          SRE Atlas
        </a>
      </div>

      <!-- Center: search -->
      <div class="topnav__center">
        <button id="search-trigger" class="topnav__search" aria-label="Search" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <span class="topnav__search-text">{isEnglish ? "Search…" : "搜索…"}</span>
          <kbd class="topnav__kbd">Ctrl K</kbd>
        </button>
      </div>

      <!-- Right: mermaid + notifications + translate + theme + login -->
      <div class="topnav__right">
        <a href="/mermaid" class="topnav__icon-btn" aria-label="Mermaid diagrams" title="Mermaid 图表">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 32 32" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M2.29533 2.29533C0 4.59065 0 8.28492 0 15.6735V16.3265C0 23.7151 0 27.4093 2.29533 29.7047C4.59065 32 8.28492 32 15.6735 32H16.3265C23.7151 32 27.4093 32 29.7047 29.7047C32 27.4093 32 23.7151 32 16.3265V15.6735C32 8.28492 32 4.59065 29.7047 2.29533C27.4093 0 23.7151 0 16.3265 0H15.6735C8.28492 0 4.59065 0 2.29533 2.29533ZM25.591 8.00902C23.5165 7.9193 21.4677 8.50072 19.7428 9.66872C18.0178 10.8367 16.7066 12.5303 15.9998 14.5033C15.2931 12.5303 13.9819 10.8367 12.2569 9.66872C10.5319 8.50072 8.48321 7.9193 6.40869 8.00902C6.33904 9.68553 6.69323 11.3523 7.43783 12.8522C8.18243 14.352 9.2929 15.6354 10.6645 16.5813C11.3681 17.0697 11.9432 17.7242 12.3397 18.4881C12.7363 19.252 12.9423 20.1021 12.94 20.9647V24H19.0603V20.9647C19.0578 20.1022 19.2637 19.252 19.6602 18.4881C20.0566 17.7243 20.6316 17.0697 21.3352 16.5813C22.7071 15.6358 23.8179 14.3524 24.5625 12.8525C25.3072 11.3526 25.6611 9.68561 25.591 8.00902ZM11.0123 20.9647C11.0152 20.4193 10.8861 19.8813 10.6363 19.3978C10.3865 18.9142 10.0235 18.4997 9.57897 18.1903C8.97481 17.7737 8.41051 17.301 7.89343 16.7782C7.33431 16.2122 6.83385 15.5899 6.39984 14.921V24H11.0123V20.9647ZM21.3634 19.3978C21.1136 19.8813 20.9845 20.4193 20.9873 20.9647V24H25.5998V14.921C25.1658 15.5899 24.6654 16.2122 24.1062 16.7782C23.5892 17.301 23.0249 17.7737 22.4207 18.1903C21.9762 18.4997 21.6132 18.9142 21.3634 19.3978Z"/>
          </svg>
        </a>
        <!-- Notifications -->
        <a href="/notifications" class="topnav__icon-btn" aria-label="Notifications">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <path d="M2.8 2.06A1.75 1.75 0 0 1 4.41 1h7.18c.7 0 1.333.417 1.61 1.06l2.74 6.395c.04.093.06.194.06.295v4.5A1.75 1.75 0 0 1 14.25 15H1.75A1.75 1.75 0 0 1 0 13.25v-4.5c0-.101.02-.202.06-.295Zm1.61.44a.25.25 0 0 0-.23.152L1.887 8H4.75a.75.75 0 0 1 .6.3L6.625 10h2.75l1.275-1.7a.75.75 0 0 1 .6-.3h2.863L11.82 2.652a.25.25 0 0 0-.23-.152Zm10.09 7h-2.875l-1.275 1.7a.75.75 0 0 1-.6.3h-3.5a.75.75 0 0 1-.6-.3L4.375 9.5H1.5v3.75c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25Z"></path>
          </svg>
        </a>
        <!-- Language switcher -->
        <LanguageSwitcher client:idle />
        <!-- Theme toggle -->
        <ThemeToggle client:idle />
        <!-- Auth -->
        <div class="topnav__auth" id="auth-buttons">
          <a href="/auth/login" class="topnav__auth-btn topnav__auth-btn--combined">
            {isEnglish ? "Sign up / Sign in" : "注册 / 登录"}
          </a>
        </div>
        <div class="topnav__user" id="auth-user" style="display:none">
          <AuthButton client:load />
        </div>
      </div>
    </nav>

    <!-- Pagefind Search -->
    <PagefindSearch client:load />

    <!-- Layout -->
    <div class="atlas-layout">
      {/* Left Sidebar — visible on desktop, hidden on mobile until toggled */}
      <aside class="atlas-sidebar" id="atlas-sidebar" aria-label="Page navigation">
        <nav class="sidebar__nav">
          {sidebarGroups.map((group) => (
            <div class="sidebar__group">
              <button type="button" class="sidebar__group-header" aria-expanded="false">
                <span class="sidebar__group-icon" set:html={group.icon} />
                <span class="sidebar__group-label">{group.label}</span>
                <span class="sidebar__chevron" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M12.78 6.22a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L3.22 7.28a.751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018L8 9.94l3.72-3.72a.75.75 0 0 1 1.06 0Z"/></svg>
                </span>
              </button>
              <ul class="sidebar__list sidebar__list--collapsed">
                {group.pages.map((page) => (
                  <li>
                    <a
                      href={page.href}
                      class:list={["sidebar__link", { "sidebar__link--active": isPageActive(page.href) }]}
                    >
                      {page.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </aside>

      <!-- Sidebar backdrop (mobile) -->
      <div id="sidebar-backdrop" class="sidebar-backdrop" aria-hidden="true"></div>

      <main class:list={["atlas-main", { "atlas-main--full": isHome }]} id="atlas-main">
        <article class="prose">
          <slot />
          {updated && <LastModified date={updated} />}
        </article>
      </main>

      {headings.length > 0 && (
        <aside class="atlas-toc" aria-label="Table of contents">
          <div class="atlas-toc__inner">
            <p class="atlas-toc__title">{isEnglish ? "On this page" : "本页目录"}</p>
            <TOC headings={headings} />
          </div>
        </aside>
      )}
    </div>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__row">
          <span class="site-footer__left">
            SRE Atlas
            <span class="site-footer__sep" aria-hidden="true">·</span>
            <a href="https://github.com/lin327/sre-wiki" class="site-footer__link" target="_blank" rel="noopener noreferrer">GitHub</a>
            <span class="site-footer__sep" aria-hidden="true">·</span>
            <a href="https://github.com/lin327/sre-atlas-agent" class="site-footer__link" target="_blank" rel="noopener noreferrer">Agent</a>
          </span>
        </div>
        <div class="site-footer__copy">
          © 2026 lin327
        </div>
      </div>
    </footer>

    <!-- Keyboard Shortcuts Overlay -->
    <div id="shortcuts-overlay" class="shortcuts-overlay" hidden>
      <div class="shortcuts-dialog" role="dialog" aria-label="Keyboard shortcuts">
        <div class="shortcuts-dialog__header">
          <h3 class="shortcuts-dialog__title">Keyboard Shortcuts</h3>
          <button id="shortcuts-close" class="shortcuts-dialog__close" aria-label="Close" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" x2="6" y1="6" y2="18"></line>
              <line x1="6" x2="18" y1="6" y2="18"></line>
            </svg>
          </button>
        </div>
        <ul class="shortcuts-dialog__list">
          <li class="shortcuts-dialog__item">
            <span class="shortcuts-dialog__desc">Search</span>
            <kbd class="shortcuts-dialog__kbd">Ctrl</kbd><span class="shortcuts-dialog__plus">+</span><kbd class="shortcuts-dialog__kbd">K</kbd>
          </li>
          <li class="shortcuts-dialog__item">
            <span class="shortcuts-dialog__desc">Close dialogs</span>
            <kbd class="shortcuts-dialog__kbd">Esc</kbd>
          </li>
          <li class="shortcuts-dialog__item">
            <span class="shortcuts-dialog__desc">Show this help</span>
            <kbd class="shortcuts-dialog__kbd">?</kbd>
          </li>
        </ul>
      </div>
    </div>

    <style>
      /* Skip link for keyboard/screen reader accessibility */
      .skip-link {
        position: absolute;
        top: -100%;
        left: 16px;
        z-index: var(--z-toast);
        padding: 8px 16px;
        background: var(--color-primary);
        color: #fff;
        font-size: 14px;
        font-weight: 500;
        border-radius: 0 0 6px 6px;
        text-decoration: none;
        transition: top 150ms ease;
      }
      .skip-link:focus {
        top: 0;
      }

      @media (prefers-reduced-motion: no-preference) {
        ::view-transition-old(root) {
          animation: vt-fade-out 200ms ease-out both;
        }
        ::view-transition-new(root) {
          animation: vt-fade-in 250ms ease-in both;
        }
      }

      @keyframes vt-fade-out {
        from { opacity: 1; transform: translateY(0); }
        to   { opacity: 0; transform: translateY(-6px); }
      }
      @keyframes vt-fade-in {
        from { opacity: 0; transform: translateY(6px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      /* Scroll Progress */
      .scroll-progress {
        position: fixed;
        top: 0;
        left: 0;
        z-index: var(--z-sticky);
        width: 0%;
        height: 2px;
        background: var(--color-primary);
        transition: width 50ms linear;
        pointer-events: none;
      }

      /* Top Navigation — GitHub-style clean */
      .topnav {
        position: sticky;
        top: 0;
        z-index: var(--z-sticky);
        height: 52px;
        display: flex;
        align-items: center;
        padding: 0 24px;
        background: var(--color-surface);
        border-bottom: 1px solid var(--color-border);
        transition: background var(--motion-normal) ease,
                    box-shadow var(--motion-normal) ease;
      }
      .topnav--scrolled {
        box-shadow: var(--shadow-sm);
      }

      .topnav__left {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
      }

      .topnav__brand {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        font-weight: 600;
        color: var(--color-ink);
        white-space: nowrap;
        text-decoration: none;
        flex-shrink: 0;
      }
      .topnav__brand:hover {
        color: var(--color-primary);
        text-decoration: none;
      }

      .topnav__dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--color-primary);
        flex-shrink: 0;
        animation: dot-breathe 3s ease-in-out infinite;
      }
      @keyframes dot-breathe {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(0.75); }
      }

      .topnav__center {
        flex: 1;
        display: flex;
        justify-content: center;
      }

      .topnav__link {
        position: relative;
