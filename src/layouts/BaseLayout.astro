---
import "../styles/design-system.css";
import ThemeToggle from "../components/react/ThemeToggle.tsx";
import PagefindSearch from "../components/react/PagefindSearch.tsx";
import AuthButton from "../components/react/AuthButton.tsx";
import LanguageSwitcher from "../components/react/LanguageSwitcher.tsx";
import TOC from "../components/astro/TOC.astro";
import LastModified from "../components/astro/LastModified.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  headings?: Heading[];
  updated?: string;
}

const {
  title = "SRE Atlas",
  description = "SRE 知识图谱与运维手册",
  headings = [],
  updated,
} = Astro.props;

const currentPath = Astro.url.pathname;
const isHome = currentPath === "/";

const topNavLinks = [
  { href: "/linux/process-model", label: "Linux" },
  { href: "/docker/image-layers", label: "Docker" },
  { href: "/kubernetes/pod-lifecycle", label: "Kubernetes" },
  { href: "/runbooks/crashloopbackoff", label: "Runbook" },
  { href: "/architectures/ha-cluster", label: "Architecture" },
  { href: "/incidents/etcd-data-corruption", label: "Incidents" },
  { href: "/comparisons/helm-vs-kustomize", label: "Comparisons" },
];

/* Sidebar page groups */
const sidebarGroups = [
  {
    label: "Linux",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2Zm2 .5v11a.5.5 0 0 0 .5.5h11a.5.5 0 0 0 .5-.5v-11a.5.5 0 0 0-.5-.5h-11a.5.5 0 0 0-.5.5ZM4 5h8v1H4V5Zm0 3h6v1H4V8Z"/></svg>`,
    pages: [
      { href: "/linux/process-model", label: "进程模型" },
      { href: "/linux/filesystem", label: "文件系统" },
      { href: "/linux/network-stack", label: "网络栈" },
      { href: "/linux/systemd", label: "systemd" },
    ],
  },
  {
    label: "Docker",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M13.02 7.222c-.012-.06-.028-.118-.046-.176l.003.012c-.088-.44-.39-.81-.81-1.047a1.7 1.7 0 0 0-.846-.21H9.13c-.16-.6-.45-1.13-.84-1.55C7.46 3.43 6.34 3 5.14 3c-.8 0-1.58.2-2.12.55A2.16 2.16 0 0 0 2 5.5c0 .4.1.78.32 1.12.2.3.48.54.8.7-.04.06-.07.14-.1.2C2.35 7.87 2 8.48 2 9.22c0 1.26.75 2.28 2.12 2.85.97.4 2.17.58 3.38.58.4 0 .8-.02 1.18-.07.48-.06.93-.18 1.34-.36.65-.29 1.18-.74 1.55-1.3.17-.25.3-.52.38-.8.14-.02.28-.06.4-.1.35-.13.64-.32.86-.57.2-.22.35-.5.44-.8.06-.2.1-.4.1-.62 0-.28-.06-.54-.16-.78a1.7 1.7 0 0 0-.4-.58c.08-.16.14-.34.18-.52.06-.28.08-.58.04-.88ZM3 6.5c0-.46.2-.86.52-1.14.3-.26.68-.36 1.02-.36.46 0 .92.16 1.3.44.3.24.52.56.62.92H3Zm3.38 5.44c-.78 0-1.58-.1-2.3-.34-1.06-.34-1.5-.86-1.5-1.58 0-.44.16-.82.44-1.12.28-.3.64-.48 1.08-.56.2-.04.42-.06.64-.08h5.88c-.12.44-.34.84-.66 1.16-.4.4-.9.66-1.46.78-.34.08-.7.12-1.06.12l-1.6.02ZM14 5.5h-1.5V4h-1v1.5H10v1h1.5V8h1V6.5H14v-1Z"/></svg>`,
    pages: [
      { href: "/docker/image-layers", label: "镜像层" },
      { href: "/docker/compose", label: "Compose" },
      { href: "/docker/networking", label: "网络" },
      { href: "/docker/storage", label: "存储" },
    ],
  },
  {
    label: "Kubernetes",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0Zm3.67 11.36-4.67 2.7a.5.5 0 0 1-.5 0l-4.67-2.7a.5.5 0 0 1-.25-.43V5.07a.5.5 0 0 1 .25-.43l4.67-2.7a.5.5 0 0 1 .5 0l4.67 2.7a.5.5 0 0 1 .25.43v5.86a.5.5 0 0 1-.25.43ZM8 1.4 3.8 3.8v6.4L8 12.6l4.2-2.4V3.8L8 1.4Z"/><path d="M8 5a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm0 1a2 2 0 1 1 0 4 2 2 0 0 1 0-4Z"/></svg>`,
    pages: [
      { href: "/kubernetes/pod-lifecycle", label: "Pod 生命周期" },
      { href: "/kubernetes/service-mesh", label: "Service Mesh" },
      { href: "/kubernetes/container-runtime", label: "容器运行时" },
    ],
  },
  {
    label: "Runbooks",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.5a.5.5 0 0 1 .5.5v5.793l2.146-2.147a.5.5 0 0 1 .708.708l-3 3a.5.5 0 0 1-.708 0l-3-3a.5.5 0 1 1 .708-.708L7.5 7.793V2a.5.5 0 0 1 .5-.5Z"/><path d="M2 12.5a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5Z"/></svg>`,
    pages: [
      { href: "/runbooks/crashloopbackoff", label: "CrashLoopBackOff" },
      { href: "/runbooks/imagepullbackoff", label: "ImagePullBackOff" },
      { href: "/runbooks/oomkilled", label: "OOMKilled" },
    ],
  },
  {
    label: "Architecture",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M6 1a1 1 0 0 0-1 1v2H3a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V8h2a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1h-2V2a1 1 0 0 0-1-1H6Zm0 1h4v2h2v2h-2v4H8V6H6V4h2V2Z"/></svg>`,
    pages: [
      { href: "/architectures/ha-cluster", label: "高可用集群" },
      { href: "/architectures/gitops-pipeline", label: "GitOps Pipeline" },
    ],
  },
  {
    label: "Incidents",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872l-.1-.34ZM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.858Z"/></svg>`,
    pages: [
      { href: "/incidents/etcd-data-corruption", label: "etcd 数据损坏" },
      { href: "/incidents/dns-resolution-failure", label: "DNS 解析故障" },
    ],
  },
  {
    label: "Comparisons",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M6 12.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5ZM3 8.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5Zm0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5Z"/></svg>`,
    pages: [
      { href: "/comparisons/helm-vs-kustomize", label: "Helm vs Kustomize" },
      { href: "/comparisons/istio-vs-linkerd", label: "Istio vs Linkerd" },
    ],
  },
  {
    label: "可观测性",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Z"/><path d="M8 4a.5.5 0 0 1 .5.5v3.5H12a.5.5 0 0 1 0 1H8.5V12.5a.5.5 0 0 1-1 0V9H4a.5.5 0 0 1 0-1h3.5V4.5A.5.5 0 0 1 8 4Z"/></svg>`,
    pages: [
      { href: "/articles#observability", label: "Prometheus & Grafana (41)" },
    ],
  },
  {
    label: "Kubernetes",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0Zm3.67 11.36-4.67 2.7a.5.5 0 0 1-.5 0l-4.67-2.7a.5.5 0 0 1-.25-.43V5.07a.5.5 0 0 1 .25-.43l4.67-2.7a.5.5 0 0 1 .5 0l4.67 2.7a.5.5 0 0 1 .25.43v5.86a.5.5 0 0 1-.25.43ZM8 1.4 3.8 3.8v6.4L8 12.6l4.2-2.4V3.8L8 1.4Z"/><path d="M8 5a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm0 1a2 2 0 1 1 0 4 2 2 0 0 1 0-4Z"/></svg>`,
    pages: [
      { href: "/articles#k8s", label: "K8s 生态 (30)" },
    ],
  },
  {
    label: "安全",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0c-.69 0-1.843.26-2.928.558a1.34 1.34 0 0 0-.633.272C3.582 1.246 2.912 2.078 2.604 2.5c-.308.422-.77 1.254-1.604 2.056A17.47 17.47 0 0 0 0 8c0 .863.07 1.662.202 2.436.07.418.165.83.283 1.236.118.406.26.81.425 1.2.163.39.35.762.558 1.112l.148.253c.143.243.307.47.49.68.184.21.392.398.62.563.227.165.48.305.75.42.27.116.562.207.87.27.308.064.632.097.97.097.338 0 .662-.033.97-.097.308-.063.6-.154.87-.27.27-.115.523-.255.75-.42.228-.165.436-.353.62-.563.183-.21.347-.437.49-.68l.148-.253c.208-.35.395-.722.558-1.112.165-.39.307-.794.425-1.2a14.96 14.96 0 0 0 .283-1.236A17.47 17.47 0 0 0 16 8c0-.863-.07-1.662-.202-2.436a9.64 9.64 0 0 0-.283-1.236 9.08 9.08 0 0 0-.425-1.2c-.163-.39-.35-.762-.558-1.112a5.88 5.88 0 0 0-.148-.253 5.06 5.06 0 0 0-.49-.68 4.39 4.39 0 0 0-.62-.563 3.87 3.87 0 0 0-.75-.42A3.94 3.94 0 0 0 9.7 0C9.01 0 7.857.26 6.772.558a1.34 1.34 0 0 0-.633.272C5.282 1.246 4.612 2.078 4.304 2.5c-.308.422-.77 1.254-1.604 2.056A17.47 17.47 0 0 0 2.7 8Z"/></svg>`,
    pages: [
      { href: "/articles#security", label: "安全与合规 (21)" },
    ],
  },
  {
    label: "SRE 实践",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.5a.5.5 0 0 1 .5.5v5.793l2.146-2.147a.5.5 0 0 1 .708.708l-3 3a.5.5 0 0 1-.708 0l-3-3a.5.5 0 1 1 .708-.708L7.5 7.793V2a.5.5 0 0 1 .5-.5Z"/><path d="M2 12.5a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5Z"/></svg>`,
    pages: [
      { href: "/articles#sre", label: "SRE 最佳实践 (20)" },
    ],
  },
  {
    label: "混沌工程",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872l-.1-.34ZM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.858Z"/></svg>`,
    pages: [
      { href: "/articles#chaos", label: "Chaos Mesh (18)" },
    ],
  },
  {
    label: "DevOps",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M6 1a1 1 0 0 0-1 1v2H3a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V8h2a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1h-2V2a1 1 0 0 0-1-1H6Zm0 1h4v2h2v2h-2v4H8V6H6V4h2V2Z"/></svg>`,
    pages: [
      { href: "/articles#devops", label: "CI/CD & 平台 (11)" },
    ],
  },
];

function isActive(href: string): boolean {
  return currentPath.startsWith(href.replace(/\/[^\/]*$/, ""));
}

function isPageActive(href: string): boolean {
  return currentPath === href || currentPath === href + "/";
}
---

<!doctype html>
<html lang="zh" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="view-transition" content="same-origin" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | SRE Atlas</title>
  </head>
  <body>
    <!-- Scroll Progress Bar -->
    <div id="scroll-progress" class="scroll-progress" aria-hidden="true"></div>

    <!-- Top Navigation -->
    <nav class="topnav" id="topnav">
      <!-- Left: menu + logo -->
      <div class="topnav__left">
        <button id="sidebar-toggle" class="topnav__menu" aria-label="Toggle menu" aria-expanded="true" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" x2="21" y1="6" y2="6"></line>
            <line x1="3" x2="21" y1="12" y2="12"></line>
            <line x1="3" x2="21" y1="18" y2="18"></line>
          </svg>
        </button>
        <a href="/" class="topnav__brand">
          <span class="topnav__dot" aria-hidden="true"></span>
          SRE Atlas
        </a>
      </div>

      <!-- Center: search -->
      <div class="topnav__center">
        <button id="search-trigger" class="topnav__search" aria-label="Search" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <span class="topnav__search-text">搜索…</span>
          <kbd class="topnav__kbd">Ctrl K</kbd>
        </button>
      </div>

      <!-- Right: notifications + translate + theme + login -->
      <div class="topnav__right">
        <!-- Notifications -->
        <a href="/notifications" class="topnav__icon-btn" aria-label="Notifications">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <path d="M2.8 2.06A1.75 1.75 0 0 1 4.41 1h7.18c.7 0 1.333.417 1.61 1.06l2.74 6.395c.04.093.06.194.06.295v4.5A1.75 1.75 0 0 1 14.25 15H1.75A1.75 1.75 0 0 1 0 13.25v-4.5c0-.101.02-.202.06-.295Zm1.61.44a.25.25 0 0 0-.23.152L1.887 8H4.75a.75.75 0 0 1 .6.3L6.625 10h2.75l1.275-1.7a.75.75 0 0 1 .6-.3h2.863L11.82 2.652a.25.25 0 0 0-.23-.152Zm10.09 7h-2.875l-1.275 1.7a.75.75 0 0 1-.6.3h-3.5a.75.75 0 0 1-.6-.3L4.375 9.5H1.5v3.75c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25Z"></path>
          </svg>
        </a>
        <!-- Language switcher -->
        <LanguageSwitcher client:load />
        <!-- Theme toggle -->
        <ThemeToggle client:load />
        <!-- Auth -->
        <div class="topnav__auth" id="auth-buttons">
          <a href="/auth/register" class="topnav__auth-btn topnav__auth-btn--outline">注册</a>
          <a href="/auth/login" class="topnav__auth-btn topnav__auth-btn--primary">登录</a>
        </div>
        <div class="topnav__user" id="auth-user" style="display:none">
          <AuthButton client:load />
        </div>
      </div>
    </nav>

    <!-- Pagefind Search -->
    <PagefindSearch client:idle />

    <!-- Layout -->
    <div class="atlas-layout">
      {/* Left Sidebar — always visible */}
      <aside class="atlas-sidebar atlas-sidebar--open" id="atlas-sidebar" aria-label="Page navigation">
        <nav class="sidebar__nav">
          {sidebarGroups.map((group) => (
            <div class="sidebar__group">
              <button type="button" class="sidebar__group-header" aria-expanded="false">
                <span class="sidebar__group-icon" set:html={group.icon} />
                <span class="sidebar__group-label">{group.label}</span>
                <span class="sidebar__chevron" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="currentColor"><path d="M12.78 6.22a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L3.22 7.28a.751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018L8 9.94l3.72-3.72a.75.75 0 0 1 1.06 0Z"/></svg>
                </span>
              </button>
              <ul class="sidebar__list sidebar__list--collapsed">
                {group.pages.map((page) => (
                  <li>
                    <a
                      href={page.href}
                      class:list={["sidebar__link", { "sidebar__link--active": isPageActive(page.href) }]}
                    >
                      {page.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </aside>

      <!-- Sidebar backdrop (mobile) -->
      <div id="sidebar-backdrop" class="sidebar-backdrop" aria-hidden="true"></div>

      <main class:list={["atlas-main", { "atlas-main--full": isHome }]} id="atlas-main">
        <article class="prose">
          <slot />
          {updated && <LastModified date={updated} />}
        </article>
      </main>

      {headings.length > 0 && (
        <aside class="atlas-toc" aria-label="Table of contents">
          <div class="atlas-toc__inner">
            <p class="atlas-toc__title">On this page</p>
            <TOC headings={headings} />
          </div>
        </aside>
      )}
    </div>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__row">
          <span class="site-footer__left">
            SRE Atlas
            <span class="site-footer__sep" aria-hidden="true">·</span>
            <a href="https://github.com/lin327/sre-wiki" class="site-footer__link" target="_blank" rel="noopener noreferrer">GitHub</a>
            <span class="site-footer__sep" aria-hidden="true">·</span>
            <a href="https://github.com/lin327/sre-atlas-agent" class="site-footer__link" target="_blank" rel="noopener noreferrer">Agent</a>
          </span>
          <a href="https://beian.miit.gov.cn" class="site-footer__link" target="_blank" rel="noopener noreferrer">
            闽ICP备2025088055号
          </a>
        </div>
        <div class="site-footer__copy">
          © 2026 lin327
        </div>
      </div>
    </footer>

    <!-- Keyboard Shortcuts Overlay -->
    <div id="shortcuts-overlay" class="shortcuts-overlay" hidden>
      <div class="shortcuts-dialog" role="dialog" aria-label="Keyboard shortcuts">
        <div class="shortcuts-dialog__header">
          <h3 class="shortcuts-dialog__title">Keyboard Shortcuts</h3>
          <button id="shortcuts-close" class="shortcuts-dialog__close" aria-label="Close" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" x2="6" y1="6" y2="18"></line>
              <line x1="6" x2="18" y1="6" y2="18"></line>
            </svg>
          </button>
        </div>
        <ul class="shortcuts-dialog__list">
          <li class="shortcuts-dialog__item">
            <span class="shortcuts-dialog__desc">Search</span>
            <kbd class="shortcuts-dialog__kbd">Ctrl</kbd><span class="shortcuts-dialog__plus">+</span><kbd class="shortcuts-dialog__kbd">K</kbd>
          </li>
          <li class="shortcuts-dialog__item">
            <span class="shortcuts-dialog__desc">Close dialogs</span>
            <kbd class="shortcuts-dialog__kbd">Esc</kbd>
          </li>
          <li class="shortcuts-dialog__item">
            <span class="shortcuts-dialog__desc">Show this help</span>
            <kbd class="shortcuts-dialog__kbd">?</kbd>
          </li>
        </ul>
      </div>
    </div>

    <style>
      @media (prefers-reduced-motion: no-preference) {
        ::view-transition-old(root) {
          animation: vt-fade-out 200ms ease-out both;
        }
        ::view-transition-new(root) {
          animation: vt-fade-in 250ms ease-in both;
        }
      }

      @keyframes vt-fade-out {
        from { opacity: 1; transform: translateY(0); }
        to   { opacity: 0; transform: translateY(-6px); }
      }
      @keyframes vt-fade-in {
        from { opacity: 0; transform: translateY(6px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      /* Scroll Progress */
      .scroll-progress {
        position: fixed;
        top: 0;
        left: 0;
        z-index: var(--z-sticky);
        width: 0%;
        height: 2px;
        background: var(--color-primary);
        transition: width 50ms linear;
        pointer-events: none;
      }

      /* Top Navigation — GitHub-style clean */
      .topnav {
        position: sticky;
        top: 0;
        z-index: var(--z-sticky);
        height: 52px;
        display: flex;
        align-items: center;
        padding: 0 24px;
        background: var(--color-surface);
        border-bottom: 1px solid var(--color-border);
        transition: background var(--motion-normal) ease,
                    box-shadow var(--motion-normal) ease;
      }
      .topnav--scrolled {
        box-shadow: var(--shadow-sm);
      }

      .topnav__left {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
      }

      .topnav__brand {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        font-weight: 600;
        color: var(--color-ink);
        white-space: nowrap;
        text-decoration: none;
        flex-shrink: 0;
      }
      .topnav__brand:hover {
        color: var(--color-primary);
        text-decoration: none;
      }

      .topnav__dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--color-primary);
        flex-shrink: 0;
        animation: dot-breathe 3s ease-in-out infinite;
      }
      @keyframes dot-breathe {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(0.75); }
      }

      .topnav__center {
        flex: 1;
        display: flex;
        justify-content: center;
      }

      .topnav__link {
        position: relative;
        padding: 5px 12px;
        border-radius: var(--radius-md);
        font-size: 13px;
        font-weight: 400;
        color: var(--color-muted);
        text-decoration: none;
        transition: background var(--motion-fast) ease, color var(--motion-fast) ease;
        white-space: nowrap;
      }
      .topnav__link:hover {
        background: var(--color-surface-2);
        color: var(--color-ink);
        text-decoration: none;
      }
      .topnav__link--active {
        color: var(--color-ink);
        font-weight: 600;
      }

      .topnav__menu {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        background: var(--color-surface-2);
        color: var(--color-dim);
        cursor: pointer;
        transition: border-color var(--motion-fast) ease,
                    background var(--motion-fast) ease;
        flex-shrink: 0;
        margin-right: 20px;
      }
      .topnav__menu:hover {
        border-color: var(--color-primary);
        background: var(--color-surface);
      }

      .topnav__right {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
      }

      .topnav__icon-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        background: var(--color-surface-2);
        color: var(--color-dim);
        cursor: pointer;
        text-decoration: none;
        transition: border-color var(--motion-fast) ease,
                    background var(--motion-fast) ease;
      }
      .topnav__icon-btn:hover {
        border-color: var(--color-primary);
        background: var(--color-surface);
        color: var(--color-ink);
      }

      .topnav__auth {
        display: flex;
        align-items: center;
        gap: 6px;
      }

      .topnav__auth-btn {
        display: flex;
        align-items: center;
        height: 30px;
        padding: 0 14px;
        border-radius: var(--radius-md);
        font-size: 12px;
        font-weight: 500;
        text-decoration: none;
        transition: border-color var(--motion-fast) ease,
                    background var(--motion-fast) ease,
                    color var(--motion-fast) ease;
      }

      .topnav__auth-btn--outline {
        border: 1px solid var(--color-border);
        background: transparent;
        color: var(--color-ink);
      }
      .topnav__auth-btn--outline:hover {
        border-color: var(--color-primary);
        background: var(--color-surface-2);
      }

      .topnav__auth-btn--primary {
        border: 1px solid var(--color-primary);
        background: var(--color-primary);
        color: #fff;
      }
      .topnav__auth-btn--primary:hover {
        opacity: 0.9;
      }

      .topnav__user {
        display: flex;
        align-items: center;
      }

      .topnav__search {
        display: flex;
        align-items: center;
        gap: 6px;
        width: 400px;
        height: 31px;
        padding: 0 10px 0 10px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        background: var(--color-surface-2);
        color: var(--color-dim);
        font-size: 12px;
        cursor: pointer;
        transition: border-color var(--motion-fast) ease,
                    background var(--motion-fast) ease;
      }
      .topnav__search:hover {
        border-color: var(--color-primary);
        background: var(--color-surface);
      }

      .topnav__search-text { white-space: nowrap; }

      .topnav__kbd {
        padding: 1px 5px;
        border-radius: 3px;
        border: 1px solid var(--color-border);
        background: var(--color-surface);
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--color-dim);
        pointer-events: none;
        line-height: 1.4;
      }

      /* Layout — with optional sidebar */
      .atlas-layout {
        display: flex;
        min-height: calc(100vh - 52px);
      }

      /* Left Sidebar */
      .atlas-sidebar {
        width: 260px;
        flex-shrink: 0;
        border-right: 1px solid var(--color-border);
        background: var(--color-surface);
        overflow-y: auto;
        padding: 16px 0;
        transition: margin-left var(--motion-normal) ease;
      }

      /* Closed state — slide out */
      .atlas-sidebar.atlas-sidebar--closed {
        margin-left: -260px;
      }

      /* Mobile: hidden by default, overlay when open */
      @media (max-width: 1023px) {
        .atlas-sidebar {
          display: none;
          margin-left: 0;
        }
        .atlas-sidebar.atlas-sidebar--closed {
          margin-left: 0;
        }
        .atlas-sidebar.atlas-sidebar--open {
          display: block;
          position: fixed;
          top: 52px;
          left: 0;
          bottom: 0;
          z-index: var(--z-overlay);
          box-shadow: var(--shadow-lg);
        }
      }

      .sidebar-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        top: 52px;
        z-index: calc(var(--z-overlay) - 1);
        background: rgba(0, 0, 0, 0.3);
      }
      .sidebar-backdrop--visible {
        display: block;
      }
      @media (min-width: 1024px) {
        .sidebar-backdrop { display: none !important; }
      }

      .sidebar__nav {
        display: flex;
        flex-direction: column;
      }

      .sidebar__group {
        padding: 0 12px;
        margin-bottom: 8px;
      }

      .sidebar__group-header {
        display: flex;
        align-items: center;
        gap: 8px;
        width: 100%;
        padding: 6px 8px;
        border: none;
        background: transparent;
        font-size: 12px;
        font-weight: 600;
        color: var(--color-ink);
        text-transform: uppercase;
        letter-spacing: 0.03em;
        cursor: pointer;
        transition: background var(--motion-fast) ease;
      }
      .sidebar__group-header:hover {
        background: var(--color-surface-2);
      }

      .sidebar__group-icon {
        display: flex;
        align-items: center;
        color: var(--color-dim);
        flex-shrink: 0;
      }

      .sidebar__list {
        list-style: none;
        margin: 0;
        padding: 0;
        overflow: hidden;
        transition: max-height var(--motion-normal) ease;
      }

      .sidebar__list--collapsed {
        max-height: 0 !important;
      }

      .sidebar__chevron {
        display: flex;
        align-items: center;
        margin-left: auto;
        color: var(--color-dim);
        transition: transform var(--motion-fast) ease;
      }

      .sidebar__chevron--collapsed {
        transform: rotate(-90deg);
      }

      .sidebar__link {
        display: block;
        padding: 4px 8px 4px 32px;
        font-size: 13px;
        color: var(--color-muted);
        text-decoration: none;
        border-radius: var(--radius-md);
        transition: background var(--motion-fast) ease, color var(--motion-fast) ease;
      }
      .sidebar__link:hover {
        background: var(--color-surface-2);
        color: var(--color-ink);
        text-decoration: none;
      }
      .sidebar__link--active {
        background: oklch(0.480 0.170 250.0 / 0.08);
        color: var(--color-primary);
        font-weight: 500;
      }

      /* Main content */
      .atlas-main {
        flex: 1;
        min-width: 0;
        padding: 24px 20px;
        overflow-x: hidden;
        opacity: 0;
        animation: content-fade-in 400ms var(--ease-out-expo) 80ms forwards;
      }
      .atlas-main--full {
        max-width: 1280px;
        margin: 0 auto;
      }
      @keyframes content-fade-in {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      @media (min-width: 768px) { .atlas-main { padding: 32px 32px; } }
      @media (min-width: 1280px) { .atlas-main { padding: 32px 48px; } }

      /* Content links */
      .prose :global(a:not(.topnav__link):not(.topnav__brand):not(.toc__link):not(.site-footer__link):not(.topnav__search):not(.sidebar__link):not(.card-link)) {
        position: relative;
        text-decoration: none;
        background-image: linear-gradient(var(--color-primary-l), var(--color-primary-l));
        background-size: 0% 1px;
        background-position: 0 100%;
        background-repeat: no-repeat;
        transition: background-size var(--motion-normal) var(--ease-out-expo);
      }
      .prose :global(a:not(.topnav__link):not(.topnav__brand):not(.toc__link):not(.site-footer__link):not(.topnav__search):not(.sidebar__link):not(.card-link):hover) {
        background-size: 100% 1px;
      }

      /* Heading border reveal */
      .prose :global(h2),
      .prose :global(h3) {
        position: relative;
        border-left: 3px solid transparent;
        padding-left: 0;
        transition: border-color var(--motion-slow) var(--ease-out-expo),
                    padding-left var(--motion-slow) var(--ease-out-expo);
      }
      .prose :global(h2.heading-visible),
      .prose :global(h3.heading-visible) {
        border-left-color: var(--color-primary);
        padding-left: var(--space-3);
      }

      /* TOC */
      .atlas-toc {
        display: none;
        width: 240px;
        flex-shrink: 0;
        overflow-y: auto;
        border-left: 1px solid var(--color-border);
        padding: 16px 16px 16px 20px;
      }
      @media (min-width: 1280px) { .atlas-toc { display: block; } }

      .atlas-toc__inner { position: sticky; top: 2rem; }
      .atlas-toc__title {
        margin-bottom: 0.75rem;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-dim);
      }

      /* TOC active transitions */
      :global(.toc__link) {
        transition: color var(--motion-normal) ease,
                    border-color var(--motion-normal) var(--ease-out-expo),
                    background-color var(--motion-normal) ease !important;
      }
      :global(.toc__link--active) {
        background-color: oklch(0.480 0.170 250.0 / 0.06);
      }

      /* Footer — minimal, GitHub-style */
      .site-footer {
        border-top: 1px solid var(--color-border);
        padding: 16px 32px;
      }
      .site-footer__inner {
        max-width: 1280px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
      }
      .site-footer__row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        font-size: 12px;
        color: var(--color-dim);
      }
      .site-footer__left {
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .site-footer__copy {
        font-size: 11px;
        color: var(--color-dim);
        opacity: 0.6;
      }
      .site-footer__sep {
        margin: 0 6px;
        color: var(--color-border);
      }
      .site-footer__link {
        color: var(--color-primary-l);
        text-decoration: none;
        font-size: 12px;
      }
      .site-footer__link:hover {
        text-decoration: underline;
      }

      /* Keyboard Shortcuts */
      .shortcuts-overlay {
        position: fixed;
        inset: 0;
        z-index: var(--z-overlay);
        background: oklch(0 0 0 / 0.5);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .shortcuts-overlay[hidden] { display: none; }

      .shortcuts-dialog {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
        padding: var(--space-6);
        width: min(380px, 90vw);
        box-shadow: var(--shadow-lg);
      }

      .shortcuts-dialog__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: var(--space-5);
      }
      .shortcuts-dialog__title {
        font-size: 14px;
        font-weight: 600;
        color: var(--color-ink);
        margin: 0;
      }
      .shortcuts-dialog__close {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: var(--radius-sm);
        border: none;
        background: transparent;
        color: var(--color-dim);
        cursor: pointer;
        transition: background var(--motion-fast) ease, color var(--motion-fast) ease;
      }
      .shortcuts-dialog__close:hover {
        background: var(--color-surface-2);
        color: var(--color-ink);
      }

      .shortcuts-dialog__list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
      }
      .shortcuts-dialog__item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
      }
      .shortcuts-dialog__desc {
        font-size: 13px;
        color: var(--color-muted);
      }
      .shortcuts-dialog__kbd {
        display: inline-block;
        padding: 2px 7px;
        border-radius: 4px;
        border: 1px solid var(--color-border);
        background: var(--color-surface-2);
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--color-dim);
        line-height: 1.6;
      }
      .shortcuts-dialog__plus {
        font-size: 11px;
        color: var(--color-dim);
        margin: 0 2px;
      }

      /* Reduced motion */
      @media (prefers-reduced-motion: reduce) {
        .scroll-progress { transition: none; }
        .topnav__dot { animation: none; }
        .atlas-main { animation: none; opacity: 1; }
        .prose :global(h2),
        .prose :global(h3) { transition: none; }
        .shortcuts-overlay,
        .shortcuts-dialog { animation: none; }
      }
    </style>

    <script>
      // === Sidebar group collapse/expand ===
      document.querySelectorAll(".sidebar__group").forEach((group) => {
        const btn = group.querySelector(".sidebar__group-header");
        const list = group.querySelector(".sidebar__list");
        const chevron = group.querySelector(".sidebar__chevron");
        const hasActive = group.querySelector(".sidebar__link--active");

        // Default: all collapsed except the group with active page
        if (hasActive) {
          list?.classList.remove("sidebar__list--collapsed");
          chevron?.classList.remove("sidebar__chevron--collapsed");
          btn?.setAttribute("aria-expanded", "true");
        }

        btn?.addEventListener("click", () => {
          const expanded = btn.getAttribute("aria-expanded") === "true";
          if (expanded) {
            list?.classList.add("sidebar__list--collapsed");
            chevron?.classList.add("sidebar__chevron--collapsed");
            btn.setAttribute("aria-expanded", "false");
          } else {
            list?.classList.remove("sidebar__list--collapsed");
            chevron?.classList.remove("sidebar__chevron--collapsed");
            btn.setAttribute("aria-expanded", "true");
          }
        });
      });

      // === Sidebar toggle ===
      const sidebarToggle = document.getElementById("sidebar-toggle");
      const sidebar = document.getElementById("atlas-sidebar");
      const sidebarBackdrop = document.getElementById("sidebar-backdrop");

      function isMobile() {
        return window.innerWidth < 1024;
      }

      function toggleSidebar() {
        if (isMobile()) {
          // Mobile: overlay open/close
          const isOpen = sidebar?.classList.contains("atlas-sidebar--open");
          if (isOpen) {
            sidebar?.classList.remove("atlas-sidebar--open");
            sidebarBackdrop?.classList.remove("sidebar-backdrop--visible");
            sidebarToggle?.setAttribute("aria-expanded", "false");
          } else {
            sidebar?.classList.add("atlas-sidebar--open");
            sidebarBackdrop?.classList.add("sidebar-backdrop--visible");
            sidebarToggle?.setAttribute("aria-expanded", "true");
          }
        } else {
          // Desktop: slide in/out
          const isClosed = sidebar?.classList.contains("atlas-sidebar--closed");
          if (isClosed) {
            sidebar?.classList.remove("atlas-sidebar--closed");
            sidebarToggle?.setAttribute("aria-expanded", "true");
          } else {
            sidebar?.classList.add("atlas-sidebar--closed");
            sidebarToggle?.setAttribute("aria-expanded", "false");
          }
        }
      }

      sidebarToggle?.addEventListener("click", toggleSidebar);
      sidebarBackdrop?.addEventListener("click", () => {
        sidebar?.classList.remove("atlas-sidebar--open");
        sidebarBackdrop?.classList.remove("sidebar-backdrop--visible");
        sidebarToggle?.setAttribute("aria-expanded", "false");
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isMobile()) {
          sidebar?.classList.remove("atlas-sidebar--open");
          sidebarBackdrop?.classList.remove("sidebar-backdrop--visible");
          sidebarToggle?.setAttribute("aria-expanded", "false");
        }
      });

      // === Auth state check ===
      (async () => {
        try {
          const { authClient } = await import("/src/lib/auth-client.ts");
          const res = await authClient.getSession();
          if (res.data?.user) {
            document.getElementById("auth-buttons")?.style.setProperty("display", "none");
            document.getElementById("auth-user")?.style.removeProperty("display");
          }
        } catch {}
      })();

      // === Search trigger ===
      document.getElementById("search-trigger")?.addEventListener("click", () => {
        window.dispatchEvent(new KeyboardEvent("keydown", { key: "k", ctrlKey: true, bubbles: true }));
      });

      // === Header subtle shadow on scroll ===
      const topnav = document.getElementById("topnav");
      if (topnav) {
        const scrollThreshold = 10;
        let ticking = false;
        function onScroll() {
          if (!ticking) {
            requestAnimationFrame(() => {
              topnav.classList.toggle("topnav--scrolled", window.scrollY > scrollThreshold);
              ticking = false;
            });
            ticking = true;
          }
        }
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
      }

      // === Scroll progress bar ===
      const progressBar = document.getElementById("scroll-progress");
      if (progressBar) {
        let progressTicking = false;
        function updateProgress() {
          if (!progressTicking) {
            requestAnimationFrame(() => {
              const scrollTop = window.scrollY;
              const docHeight = document.documentElement.scrollHeight - window.innerHeight;
              const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
              progressBar.style.width = pct + "%";
              progressTicking = false;
            });
            progressTicking = true;
          }
        }
        window.addEventListener("scroll", updateProgress, { passive: true });
        updateProgress();
      }

      // === Heading border reveal on scroll ===
      function initHeadingReveal() {
        const headings = document.querySelectorAll<HTMLElement>(".prose h2, .prose h3");
        if (!headings.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("heading-visible");
              }
            }
          },
          { rootMargin: "-40px 0px -60% 0px", threshold: 0 }
        );

        headings.forEach((h) => observer.observe(h));

        document.addEventListener("astro:before-swap", () => observer.disconnect(), { once: true });
      }
      initHeadingReveal();
      document.addEventListener("astro:after-swap", initHeadingReveal);

      // === Keyboard shortcuts overlay ===
      const shortcutsOverlay = document.getElementById("shortcuts-overlay");
      const shortcutsClose = document.getElementById("shortcuts-close");

      function openShortcuts() {
        if (shortcutsOverlay) shortcutsOverlay.hidden = false;
      }
      function closeShortcuts() {
        if (shortcutsOverlay) shortcutsOverlay.hidden = true;
      }

      shortcutsClose?.addEventListener("click", closeShortcuts);
      shortcutsOverlay?.addEventListener("click", (e) => {
        if (e.target === shortcutsOverlay) closeShortcuts();
      });

      document.addEventListener("keydown", (e) => {
        // "?" to open shortcuts (when not in an input)
        if (
          e.key === "?" &&
          !e.ctrlKey &&
          !e.metaKey &&
          !e.altKey &&
          !(e.target instanceof HTMLInputElement) &&
          !(e.target instanceof HTMLTextAreaElement) &&
          !(e.target instanceof HTMLSelectElement)
        ) {
          e.preventDefault();
          openShortcuts();
        }
        // Esc to close shortcuts
        if (e.key === "Escape" && shortcutsOverlay && !shortcutsOverlay.hidden) {
          closeShortcuts();
        }
      });
    </script>
  </body>
</html>
