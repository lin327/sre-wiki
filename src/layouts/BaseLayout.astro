---
import "../styles/design-system.css";
import ThemeToggle from "../components/react/ThemeToggle.tsx";
import PagefindSearch from "../components/react/PagefindSearch.tsx";
import TOC from "../components/astro/TOC.astro";
import LastModified from "../components/astro/LastModified.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title?: string;
  description?: string;
  headings?: Heading[];
  updated?: string;
}

const {
  title = "SRE Atlas",
  description = "SRE 知识图谱与运维手册",
  headings = [],
  updated,
} = Astro.props;

const currentPath = Astro.url.pathname;
const isHome = currentPath === "/";

const topNavLinks = [
  { href: "/linux/process-model", label: "Linux" },
  { href: "/docker/image-layers", label: "Docker" },
  { href: "/kubernetes/pod-lifecycle", label: "Kubernetes" },
  { href: "/runbooks/crashloopbackoff", label: "Runbook" },
  { href: "/architectures/ha-cluster", label: "Architecture" },
  { href: "/incidents/etcd-data-corruption", label: "Incidents" },
  { href: "/comparisons/helm-vs-kustomize", label: "Comparisons" },
];

/* Sidebar page groups */
const sidebarGroups = [
  {
    label: "Linux",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h9A1.5 1.5 0 0 1 14 3.5v9a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 12.5v-9ZM3.5 3a.5.5 0 0 0-.5.5v9a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5v-9a.5.5 0 0 0-.5-.5h-9ZM5 5.5A.5.5 0 0 1 5.5 5h5a.5.5 0 0 1 0 1h-5A.5.5 0 0 1 5 5.5Zm0 3A.5.5 0 0 1 5.5 8h5a.5.5 0 0 1 0 1h-5A.5.5 0 0 1 5 8.5Zm0 3a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5Z"/></svg>`,
    pages: [
      { href: "/linux/process-model", label: "进程模型" },
      { href: "/linux/filesystem", label: "文件系统" },
      { href: "/linux/network-stack", label: "网络栈" },
      { href: "/linux/systemd", label: "systemd" },
    ],
  },
  {
    label: "Docker",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M1.5 6.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-.5.5H2a.5.5 0 0 1-.5-.5v-3Zm2-1a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-4Zm2-1a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v5a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-5Zm2 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v5a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-5Zm2 1a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-4Z"/></svg>`,
    pages: [
      { href: "/docker/image-layers", label: "镜像层" },
      { href: "/docker/compose", label: "Compose" },
      { href: "/docker/networking", label: "网络" },
      { href: "/docker/storage", label: "存储" },
    ],
  },
  {
    label: "Kubernetes",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm6.5-2.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5V8h2.5a.5.5 0 0 1 0 1H8.5v2.5a.5.5 0 0 1-1 0V9H5a.5.5 0 0 1 0-1h2.5V5.5Z"/></svg>`,
    pages: [
      { href: "/kubernetes/pod-lifecycle", label: "Pod 生命周期" },
      { href: "/kubernetes/service-mesh", label: "Service Mesh" },
      { href: "/kubernetes/container-runtime", label: "容器运行时" },
    ],
  },
  {
    label: "Runbooks",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h11A1.5 1.5 0 0 1 15 2.5v11a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 1 13.5v-11ZM2.5 2a.5.5 0 0 0-.5.5v11a.5.5 0 0 0 .5.5h11a.5.5 0 0 0 .5-.5v-11a.5.5 0 0 0-.5-.5h-11ZM5 4.5A.5.5 0 0 1 5.5 4h5a.5.5 0 0 1 0 1h-5A.5.5 0 0 1 5 4.5Zm0 3A.5.5 0 0 1 5.5 7h5a.5.5 0 0 1 0 1h-5A.5.5 0 0 1 5 7.5Zm0 3a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5Z"/></svg>`,
    pages: [
      { href: "/runbooks/crashloopbackoff", label: "CrashLoopBackOff" },
      { href: "/runbooks/imagepullbackoff", label: "ImagePullBackOff" },
      { href: "/runbooks/oomkilled", label: "OOMKilled" },
    ],
  },
  {
    label: "Architecture",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.5a.5.5 0 0 1 .5.5v4.293l2.146-2.147a.5.5 0 0 1 .708.708L8.707 7.5l2.647 2.646a.5.5 0 0 1-.708.708L8.5 8.707V13a.5.5 0 0 1-1 0V8.707L5.354 10.854a.5.5 0 1 1-.708-.708L7.293 7.5 4.646 4.854a.5.5 0 1 1 .708-.708L7.5 6.293V2a.5.5 0 0 1 .5-.5Z"/></svg>`,
    pages: [
      { href: "/architectures/ha-cluster", label: "高可用集群" },
      { href: "/architectures/gitops-pipeline", label: "GitOps Pipeline" },
    ],
  },
  {
    label: "Incidents",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566ZM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5Zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z"/></svg>`,
    pages: [
      { href: "/incidents/etcd-data-corruption", label: "etcd 数据损坏" },
      { href: "/incidents/dns-resolution-failure", label: "DNS 解析故障" },
    ],
  },
  {
    label: "Comparisons",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M0 2a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2Zm6 0a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1H6Zm6-2a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2V2a2 2 0 0 0-2-2h-4Zm0 1a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1h-4ZM0 10a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-4Zm6 0a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1v-4a1 1 0 0 0-1-1H6Z"/></svg>`,
    pages: [
      { href: "/comparisons/helm-vs-kustomize", label: "Helm vs Kustomize" },
      { href: "/comparisons/istio-vs-linkerd", label: "Istio vs Linkerd" },
    ],
  },
];

function isActive(href: string): boolean {
  return currentPath.startsWith(href.replace(/\/[^\/]*$/, ""));
}

function isPageActive(href: string): boolean {
  return currentPath === href || currentPath === href + "/";
}
---

<!doctype html>
<html lang="zh" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="view-transition" content="same-origin" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | SRE Atlas</title>
  </head>
  <body>
    <!-- Scroll Progress Bar -->
    <div id="scroll-progress" class="scroll-progress" aria-hidden="true"></div>

    <!-- Top Navigation -->
    <nav class="topnav" id="topnav">
      <!-- Left: menu + logo -->
      <div class="topnav__left">
        <button id="sidebar-toggle" class="topnav__menu" aria-label="Toggle menu" aria-expanded="true" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" x2="21" y1="6" y2="6"></line>
            <line x1="3" x2="21" y1="12" y2="12"></line>
            <line x1="3" x2="21" y1="18" y2="18"></line>
          </svg>
        </button>
        <a href="/" class="topnav__brand">
          <span class="topnav__dot" aria-hidden="true"></span>
          SRE Atlas
        </a>
      </div>

      <!-- Center: search -->
      <div class="topnav__center">
        <button id="search-trigger" class="topnav__search" aria-label="Search" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
          </svg>
          <span class="topnav__search-text">搜索…</span>
          <kbd class="topnav__kbd">Ctrl K</kbd>
        </button>
      </div>

      <!-- Right: notifications + translate + theme + login -->
      <div class="topnav__right">
        <!-- Notifications -->
        <a href="/notifications" class="topnav__icon-btn" aria-label="Notifications">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <path d="M2.8 2.06A1.75 1.75 0 0 1 4.41 1h7.18c.7 0 1.333.417 1.61 1.06l2.74 6.395c.04.093.06.194.06.295v4.5A1.75 1.75 0 0 1 14.25 15H1.75A1.75 1.75 0 0 1 0 13.25v-4.5c0-.101.02-.202.06-.295Zm1.61.44a.25.25 0 0 0-.23.152L1.887 8H4.75a.75.75 0 0 1 .6.3L6.625 10h2.75l1.275-1.7a.75.75 0 0 1 .6-.3h2.863L11.82 2.652a.25.25 0 0 0-.23-.152Zm10.09 7h-2.875l-1.275 1.7a.75.75 0 0 1-.6.3h-3.5a.75.75 0 0 1-.6-.3L4.375 9.5H1.5v3.75c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25Z"></path>
          </svg>
        </a>
        <!-- Translate -->
        <button class="topnav__icon-btn" aria-label="Translate" type="button">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <path d="M1.5 1.75V13.5h13.25a.75.75 0 0 1 0 1.5H.75a.75.75 0 0 1-.75-.75V1.75a.75.75 0 0 1 1.5 0Zm14.28 2.53-5.25 5.25a.75.75 0 0 1-1.06 0L7 7.06 4.28 9.78a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042l3.25-3.25a.75.75 0 0 1 1.06 0L10 7.94l4.72-4.72a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042Z"></path>
          </svg>
        </button>
        <!-- Theme toggle -->
        <ThemeToggle client:load />
        <!-- Login -->
        <a href="/login" class="topnav__login" aria-label="Login">
          登录
        </a>
      </div>
    </nav>

    <!-- Pagefind Search -->
    <PagefindSearch client:idle />

    <!-- Layout -->
    <div class="atlas-layout">
      {/* Left Sidebar — always visible */}
      <aside class="atlas-sidebar atlas-sidebar--open" id="atlas-sidebar" aria-label="Page navigation">
        <nav class="sidebar__nav">
          {sidebarGroups.map((group) => (
            <div class="sidebar__group">
              <div class="sidebar__group-header">
                <span class="sidebar__group-icon" set:html={group.icon} />
                <span class="sidebar__group-label">{group.label}</span>
              </div>
              <ul class="sidebar__list">
                {group.pages.map((page) => (
                  <li>
                    <a
                      href={page.href}
                      class:list={["sidebar__link", { "sidebar__link--active": isPageActive(page.href) }]}
                    >
                      {page.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </aside>

      <!-- Sidebar backdrop (mobile) -->
      <div id="sidebar-backdrop" class="sidebar-backdrop" aria-hidden="true"></div>

      <main class:list={["atlas-main", { "atlas-main--full": isHome }]} id="atlas-main">
        <article class="prose">
          <slot />
          {updated && <LastModified date={updated} />}
        </article>
      </main>

      {headings.length > 0 && (
        <aside class="atlas-toc" aria-label="Table of contents">
          <div class="atlas-toc__inner">
            <p class="atlas-toc__title">On this page</p>
            <TOC headings={headings} />
          </div>
        </aside>
      )}
    </div>

    <!-- Footer -->
    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__row">
          <span class="site-footer__left">
            SRE Atlas
            <span class="site-footer__sep" aria-hidden="true">·</span>
            <a href="https://github.com/lin327/sre-wiki" class="site-footer__link" target="_blank" rel="noopener noreferrer">GitHub</a>
            <span class="site-footer__sep" aria-hidden="true">·</span>
            <a href="https://github.com/lin327/sre-atlas-agent" class="site-footer__link" target="_blank" rel="noopener noreferrer">Agent</a>
          </span>
          <a href="https://beian.miit.gov.cn" class="site-footer__link" target="_blank" rel="noopener noreferrer">
            闽ICP备2025088055号
          </a>
        </div>
        <div class="site-footer__copy">
          © 2026 lin327
        </div>
      </div>
    </footer>

    <!-- Keyboard Shortcuts Overlay -->
    <div id="shortcuts-overlay" class="shortcuts-overlay" hidden>
      <div class="shortcuts-dialog" role="dialog" aria-label="Keyboard shortcuts">
        <div class="shortcuts-dialog__header">
          <h3 class="shortcuts-dialog__title">Keyboard Shortcuts</h3>
          <button id="shortcuts-close" class="shortcuts-dialog__close" aria-label="Close" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" x2="6" y1="6" y2="18"></line>
              <line x1="6" x2="18" y1="6" y2="18"></line>
            </svg>
          </button>
        </div>
        <ul class="shortcuts-dialog__list">
          <li class="shortcuts-dialog__item">
            <span class="shortcuts-dialog__desc">Search</span>
            <kbd class="shortcuts-dialog__kbd">Ctrl</kbd><span class="shortcuts-dialog__plus">+</span><kbd class="shortcuts-dialog__kbd">K</kbd>
          </li>
          <li class="shortcuts-dialog__item">
            <span class="shortcuts-dialog__desc">Close dialogs</span>
            <kbd class="shortcuts-dialog__kbd">Esc</kbd>
          </li>
          <li class="shortcuts-dialog__item">
            <span class="shortcuts-dialog__desc">Show this help</span>
            <kbd class="shortcuts-dialog__kbd">?</kbd>
          </li>
        </ul>
      </div>
    </div>

    <style>
      @media (prefers-reduced-motion: no-preference) {
        ::view-transition-old(root) {
          animation: vt-fade-out 200ms ease-out both;
        }
        ::view-transition-new(root) {
          animation: vt-fade-in 250ms ease-in both;
        }
      }

      @keyframes vt-fade-out {
        from { opacity: 1; transform: translateY(0); }
        to   { opacity: 0; transform: translateY(-6px); }
      }
      @keyframes vt-fade-in {
        from { opacity: 0; transform: translateY(6px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      /* Scroll Progress */
      .scroll-progress {
        position: fixed;
        top: 0;
        left: 0;
        z-index: var(--z-sticky);
        width: 0%;
        height: 2px;
        background: var(--color-primary);
        transition: width 50ms linear;
        pointer-events: none;
      }

      /* Top Navigation — GitHub-style clean */
      .topnav {
        position: sticky;
        top: 0;
        z-index: var(--z-sticky);
        height: 52px;
        display: flex;
        align-items: center;
        padding: 0 24px;
        background: var(--color-surface);
        border-bottom: 1px solid var(--color-border);
        transition: background var(--motion-normal) ease,
                    box-shadow var(--motion-normal) ease;
      }
      .topnav--scrolled {
        box-shadow: var(--shadow-sm);
      }

      .topnav__left {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
      }

      .topnav__brand {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        font-weight: 600;
        color: var(--color-ink);
        white-space: nowrap;
        text-decoration: none;
        flex-shrink: 0;
      }
      .topnav__brand:hover {
        color: var(--color-primary);
        text-decoration: none;
      }

      .topnav__dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--color-primary);
        flex-shrink: 0;
        animation: dot-breathe 3s ease-in-out infinite;
      }
      @keyframes dot-breathe {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(0.75); }
      }

      .topnav__center {
        flex: 1;
        display: flex;
        justify-content: center;
      }

      .topnav__link {
        position: relative;
        padding: 5px 12px;
        border-radius: var(--radius-md);
        font-size: 13px;
        font-weight: 400;
        color: var(--color-muted);
        text-decoration: none;
        transition: background var(--motion-fast) ease, color var(--motion-fast) ease;
        white-space: nowrap;
      }
      .topnav__link:hover {
        background: var(--color-surface-2);
        color: var(--color-ink);
        text-decoration: none;
      }
      .topnav__link--active {
        color: var(--color-ink);
        font-weight: 600;
      }

      .topnav__menu {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        background: var(--color-surface-2);
        color: var(--color-dim);
        cursor: pointer;
        transition: border-color var(--motion-fast) ease,
                    background var(--motion-fast) ease;
        flex-shrink: 0;
        margin-right: 20px;
      }
      .topnav__menu:hover {
        border-color: var(--color-primary);
        background: var(--color-surface);
      }

      .topnav__right {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
      }

      .topnav__icon-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        background: var(--color-surface-2);
        color: var(--color-dim);
        cursor: pointer;
        text-decoration: none;
        transition: border-color var(--motion-fast) ease,
                    background var(--motion-fast) ease;
      }
      .topnav__icon-btn:hover {
        border-color: var(--color-primary);
        background: var(--color-surface);
        color: var(--color-ink);
      }

      .topnav__login {
        display: none;
        align-items: center;
        height: 30px;
        padding: 0 12px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        background: var(--color-surface-2);
        color: var(--color-dim);
        font-size: 12px;
        text-decoration: none;
        transition: border-color var(--motion-fast) ease,
                    background var(--motion-fast) ease;
      }
      .topnav__login:hover {
        border-color: var(--color-primary);
        background: var(--color-surface);
        color: var(--color-ink);
      }
      @media (min-width: 768px) {
        .topnav__login { display: flex; }
      }

      .topnav__search {
        display: flex;
        align-items: center;
        gap: 6px;
        width: 400px;
        height: 31px;
        padding: 0 10px 0 10px;
        border: 1px solid var(--color-border);
        border-radius: var(--radius-md);
        background: var(--color-surface-2);
        color: var(--color-dim);
        font-size: 12px;
        cursor: pointer;
        transition: border-color var(--motion-fast) ease,
                    background var(--motion-fast) ease;
      }
      .topnav__search:hover {
        border-color: var(--color-primary);
        background: var(--color-surface);
      }

      .topnav__search-text { white-space: nowrap; }

      .topnav__kbd {
        padding: 1px 5px;
        border-radius: 3px;
        border: 1px solid var(--color-border);
        background: var(--color-surface);
        font-family: var(--font-mono);
        font-size: 10px;
        color: var(--color-dim);
        pointer-events: none;
        line-height: 1.4;
      }

      /* Layout — with optional sidebar */
      .atlas-layout {
        display: flex;
        min-height: calc(100vh - 52px);
      }

      /* Left Sidebar */
      .atlas-sidebar {
        width: 260px;
        flex-shrink: 0;
        border-right: 1px solid var(--color-border);
        background: var(--color-surface);
        overflow-y: auto;
        padding: 16px 0;
        transition: margin-left var(--motion-normal) ease;
      }

      /* Closed state — slide out */
      .atlas-sidebar.atlas-sidebar--closed {
        margin-left: -260px;
      }

      /* Mobile: hidden by default, overlay when open */
      @media (max-width: 1023px) {
        .atlas-sidebar {
          display: none;
          margin-left: 0;
        }
        .atlas-sidebar.atlas-sidebar--closed {
          margin-left: 0;
        }
        .atlas-sidebar.atlas-sidebar--open {
          display: block;
          position: fixed;
          top: 52px;
          left: 0;
          bottom: 0;
          z-index: var(--z-overlay);
          box-shadow: var(--shadow-lg);
        }
      }

      .sidebar-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        top: 52px;
        z-index: calc(var(--z-overlay) - 1);
        background: rgba(0, 0, 0, 0.3);
      }
      .sidebar-backdrop--visible {
        display: block;
      }
      @media (min-width: 1024px) {
        .sidebar-backdrop { display: none !important; }
      }

      .sidebar__nav {
        display: flex;
        flex-direction: column;
      }

      .sidebar__group {
        padding: 0 12px;
        margin-bottom: 8px;
      }

      .sidebar__group-header {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 8px;
        font-size: 12px;
        font-weight: 600;
        color: var(--color-ink);
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }

      .sidebar__group-icon {
        display: flex;
        align-items: center;
        color: var(--color-dim);
        flex-shrink: 0;
      }

      .sidebar__list {
        list-style: none;
        margin: 0;
        padding: 0;
      }

      .sidebar__link {
        display: block;
        padding: 4px 8px 4px 32px;
        font-size: 13px;
        color: var(--color-muted);
        text-decoration: none;
        border-radius: var(--radius-md);
        transition: background var(--motion-fast) ease, color var(--motion-fast) ease;
      }
      .sidebar__link:hover {
        background: var(--color-surface-2);
        color: var(--color-ink);
        text-decoration: none;
      }
      .sidebar__link--active {
        background: oklch(0.480 0.170 250.0 / 0.08);
        color: var(--color-primary);
        font-weight: 500;
      }

      /* Main content */
      .atlas-main {
        flex: 1;
        min-width: 0;
        padding: 24px 20px;
        overflow-x: hidden;
        opacity: 0;
        animation: content-fade-in 400ms var(--ease-out-expo) 80ms forwards;
      }
      .atlas-main--full {
        max-width: 1280px;
        margin: 0 auto;
      }
      @keyframes content-fade-in {
        from { opacity: 0; transform: translateY(8px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      @media (min-width: 768px) { .atlas-main { padding: 32px 32px; } }
      @media (min-width: 1280px) { .atlas-main { padding: 32px 48px; } }

      /* Content links */
      .prose :global(a:not(.topnav__link):not(.topnav__brand):not(.toc__link):not(.site-footer__link):not(.topnav__search):not(.sidebar__link):not(.card-link)) {
        position: relative;
        text-decoration: none;
        background-image: linear-gradient(var(--color-primary-l), var(--color-primary-l));
        background-size: 0% 1px;
        background-position: 0 100%;
        background-repeat: no-repeat;
        transition: background-size var(--motion-normal) var(--ease-out-expo);
      }
      .prose :global(a:not(.topnav__link):not(.topnav__brand):not(.toc__link):not(.site-footer__link):not(.topnav__search):not(.sidebar__link):not(.card-link):hover) {
        background-size: 100% 1px;
      }

      /* Heading border reveal */
      .prose :global(h2),
      .prose :global(h3) {
        position: relative;
        border-left: 3px solid transparent;
        padding-left: 0;
        transition: border-color var(--motion-slow) var(--ease-out-expo),
                    padding-left var(--motion-slow) var(--ease-out-expo);
      }
      .prose :global(h2.heading-visible),
      .prose :global(h3.heading-visible) {
        border-left-color: var(--color-primary);
        padding-left: var(--space-3);
      }

      /* TOC */
      .atlas-toc {
        display: none;
        width: 240px;
        flex-shrink: 0;
        overflow-y: auto;
        border-left: 1px solid var(--color-border);
        padding: 16px 16px 16px 20px;
      }
      @media (min-width: 1280px) { .atlas-toc { display: block; } }

      .atlas-toc__inner { position: sticky; top: 2rem; }
      .atlas-toc__title {
        margin-bottom: 0.75rem;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-dim);
      }

      /* TOC active transitions */
      :global(.toc__link) {
        transition: color var(--motion-normal) ease,
                    border-color var(--motion-normal) var(--ease-out-expo),
                    background-color var(--motion-normal) ease !important;
      }
      :global(.toc__link--active) {
        background-color: oklch(0.480 0.170 250.0 / 0.06);
      }

      /* Footer — minimal, GitHub-style */
      .site-footer {
        border-top: 1px solid var(--color-border);
        padding: 16px 32px;
      }
      .site-footer__inner {
        max-width: 1280px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
      }
      .site-footer__row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        font-size: 12px;
        color: var(--color-dim);
      }
      .site-footer__left {
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .site-footer__copy {
        font-size: 11px;
        color: var(--color-dim);
        opacity: 0.6;
      }
      .site-footer__sep {
        margin: 0 6px;
        color: var(--color-border);
      }
      .site-footer__link {
        color: var(--color-primary-l);
        text-decoration: none;
        font-size: 12px;
      }
      .site-footer__link:hover {
        text-decoration: underline;
      }

      /* Keyboard Shortcuts */
      .shortcuts-overlay {
        position: fixed;
        inset: 0;
        z-index: var(--z-overlay);
        background: oklch(0 0 0 / 0.5);
        backdrop-filter: blur(4px);
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .shortcuts-overlay[hidden] { display: none; }

      .shortcuts-dialog {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-xl);
        padding: var(--space-6);
        width: min(380px, 90vw);
        box-shadow: var(--shadow-lg);
      }

      .shortcuts-dialog__header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: var(--space-5);
      }
      .shortcuts-dialog__title {
        font-size: 14px;
        font-weight: 600;
        color: var(--color-ink);
        margin: 0;
      }
      .shortcuts-dialog__close {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: var(--radius-sm);
        border: none;
        background: transparent;
        color: var(--color-dim);
        cursor: pointer;
        transition: background var(--motion-fast) ease, color var(--motion-fast) ease;
      }
      .shortcuts-dialog__close:hover {
        background: var(--color-surface-2);
        color: var(--color-ink);
      }

      .shortcuts-dialog__list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
      }
      .shortcuts-dialog__item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
      }
      .shortcuts-dialog__desc {
        font-size: 13px;
        color: var(--color-muted);
      }
      .shortcuts-dialog__kbd {
        display: inline-block;
        padding: 2px 7px;
        border-radius: 4px;
        border: 1px solid var(--color-border);
        background: var(--color-surface-2);
        font-family: var(--font-mono);
        font-size: 11px;
        color: var(--color-dim);
        line-height: 1.6;
      }
      .shortcuts-dialog__plus {
        font-size: 11px;
        color: var(--color-dim);
        margin: 0 2px;
      }

      /* Reduced motion */
      @media (prefers-reduced-motion: reduce) {
        .scroll-progress { transition: none; }
        .topnav__dot { animation: none; }
        .atlas-main { animation: none; opacity: 1; }
        .prose :global(h2),
        .prose :global(h3) { transition: none; }
        .shortcuts-overlay,
        .shortcuts-dialog { animation: none; }
      }
    </style>

    <script>
      // === Sidebar toggle ===
      const sidebarToggle = document.getElementById("sidebar-toggle");
      const sidebar = document.getElementById("atlas-sidebar");
      const sidebarBackdrop = document.getElementById("sidebar-backdrop");

      function isMobile() {
        return window.innerWidth < 1024;
      }

      function toggleSidebar() {
        if (isMobile()) {
          // Mobile: overlay open/close
          const isOpen = sidebar?.classList.contains("atlas-sidebar--open");
          if (isOpen) {
            sidebar?.classList.remove("atlas-sidebar--open");
            sidebarBackdrop?.classList.remove("sidebar-backdrop--visible");
            sidebarToggle?.setAttribute("aria-expanded", "false");
          } else {
            sidebar?.classList.add("atlas-sidebar--open");
            sidebarBackdrop?.classList.add("sidebar-backdrop--visible");
            sidebarToggle?.setAttribute("aria-expanded", "true");
          }
        } else {
          // Desktop: slide in/out
          const isClosed = sidebar?.classList.contains("atlas-sidebar--closed");
          if (isClosed) {
            sidebar?.classList.remove("atlas-sidebar--closed");
            sidebarToggle?.setAttribute("aria-expanded", "true");
          } else {
            sidebar?.classList.add("atlas-sidebar--closed");
            sidebarToggle?.setAttribute("aria-expanded", "false");
          }
        }
      }

      sidebarToggle?.addEventListener("click", toggleSidebar);
      sidebarBackdrop?.addEventListener("click", () => {
        sidebar?.classList.remove("atlas-sidebar--open");
        sidebarBackdrop?.classList.remove("sidebar-backdrop--visible");
        sidebarToggle?.setAttribute("aria-expanded", "false");
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isMobile()) {
          sidebar?.classList.remove("atlas-sidebar--open");
          sidebarBackdrop?.classList.remove("sidebar-backdrop--visible");
          sidebarToggle?.setAttribute("aria-expanded", "false");
        }
      });

      // === Search trigger ===
      document.getElementById("search-trigger")?.addEventListener("click", () => {
        window.dispatchEvent(new KeyboardEvent("keydown", { key: "k", ctrlKey: true, bubbles: true }));
      });

      // === Header subtle shadow on scroll ===
      const topnav = document.getElementById("topnav");
      if (topnav) {
        const scrollThreshold = 10;
        let ticking = false;
        function onScroll() {
          if (!ticking) {
            requestAnimationFrame(() => {
              topnav.classList.toggle("topnav--scrolled", window.scrollY > scrollThreshold);
              ticking = false;
            });
            ticking = true;
          }
        }
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
      }

      // === Scroll progress bar ===
      const progressBar = document.getElementById("scroll-progress");
      if (progressBar) {
        let progressTicking = false;
        function updateProgress() {
          if (!progressTicking) {
            requestAnimationFrame(() => {
              const scrollTop = window.scrollY;
              const docHeight = document.documentElement.scrollHeight - window.innerHeight;
              const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
              progressBar.style.width = pct + "%";
              progressTicking = false;
            });
            progressTicking = true;
          }
        }
        window.addEventListener("scroll", updateProgress, { passive: true });
        updateProgress();
      }

      // === Heading border reveal on scroll ===
      function initHeadingReveal() {
        const headings = document.querySelectorAll<HTMLElement>(".prose h2, .prose h3");
        if (!headings.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("heading-visible");
              }
            }
          },
          { rootMargin: "-40px 0px -60% 0px", threshold: 0 }
        );

        headings.forEach((h) => observer.observe(h));

        document.addEventListener("astro:before-swap", () => observer.disconnect(), { once: true });
      }
      initHeadingReveal();
      document.addEventListener("astro:after-swap", initHeadingReveal);

      // === Keyboard shortcuts overlay ===
      const shortcutsOverlay = document.getElementById("shortcuts-overlay");
      const shortcutsClose = document.getElementById("shortcuts-close");

      function openShortcuts() {
        if (shortcutsOverlay) shortcutsOverlay.hidden = false;
      }
      function closeShortcuts() {
        if (shortcutsOverlay) shortcutsOverlay.hidden = true;
      }

      shortcutsClose?.addEventListener("click", closeShortcuts);
      shortcutsOverlay?.addEventListener("click", (e) => {
        if (e.target === shortcutsOverlay) closeShortcuts();
      });

      document.addEventListener("keydown", (e) => {
        // "?" to open shortcuts (when not in an input)
        if (
          e.key === "?" &&
          !e.ctrlKey &&
          !e.metaKey &&
          !e.altKey &&
          !(e.target instanceof HTMLInputElement) &&
          !(e.target instanceof HTMLTextAreaElement) &&
          !(e.target instanceof HTMLSelectElement)
        ) {
          e.preventDefault();
          openShortcuts();
        }
        // Esc to close shortcuts
        if (e.key === "Escape" && shortcutsOverlay && !shortcutsOverlay.hidden) {
          closeShortcuts();
        }
      });
    </script>
  </body>
</html>
