    </style>

    <script>
      // === Sidebar group header click ===
      document.querySelectorAll(".sidebar__group-header--link").forEach((header) => {
        header.addEventListener("click", (e) => {
          // If click is on the chevron, toggle. Otherwise navigate.
          const chevron = e.target.closest(".sidebar__chevron");
          if (chevron) {
            e.preventDefault();
            const group = header.closest(".sidebar__group");
            const list = group?.querySelector(".sidebar__list");
            const expanded = header.getAttribute("aria-expanded") === "true";
            if (expanded) {
              list?.classList.add("sidebar__list--collapsed");
              chevron.classList.add("sidebar__chevron--collapsed");
              header.setAttribute("aria-expanded", "false");
            } else {
              list?.classList.remove("sidebar__list--collapsed");
              chevron.classList.remove("sidebar__chevron--collapsed");
              header.setAttribute("aria-expanded", "true");
            }
          }
        });
      });

      // === Sidebar group collapse/expand with localStorage ===
      const SIDEBAR_STATE_KEY = "atlas-sidebar-groups";

      function loadSidebarState() {
        try {
          return JSON.parse(localStorage.getItem(SIDEBAR_STATE_KEY) || "{}");
        } catch { return {}; }
      }

      function saveSidebarState(state) {
        try {
          localStorage.setItem(SIDEBAR_STATE_KEY, JSON.stringify(state));
        } catch {}
      }

      const sidebarState = loadSidebarState();

      document.querySelectorAll(".sidebar__group").forEach((group, index) => {
        const btn = group.querySelector(".sidebar__group-header");
        const list = group.querySelector(".sidebar__list");
        const chevron = group.querySelector(".sidebar__chevron");
        const hasActive = group.querySelector(".sidebar__link--active");
        const groupLabel = group.querySelector(".sidebar__group-label")?.textContent?.trim() || String(index);

        // Restore saved state, or expand if has active link, or collapse
        const savedOpen = sidebarState[groupLabel];
        const shouldOpen = savedOpen !== undefined ? savedOpen : !!hasActive;

        if (shouldOpen) {
          list?.classList.remove("sidebar__list--collapsed");
          chevron?.classList.remove("sidebar__chevron--collapsed");
          btn?.setAttribute("aria-expanded", "true");
        } else {
          list?.classList.add("sidebar__list--collapsed");
          chevron?.classList.add("sidebar__chevron--collapsed");
          btn?.setAttribute("aria-expanded", "false");
        }

        btn?.addEventListener("click", () => {
          const expanded = btn.getAttribute("aria-expanded") === "true";
          if (expanded) {
            list?.classList.add("sidebar__list--collapsed");
            chevron?.classList.add("sidebar__chevron--collapsed");
            btn.setAttribute("aria-expanded", "false");
            sidebarState[groupLabel] = false;
          } else {
            list?.classList.remove("sidebar__list--collapsed");
            chevron?.classList.remove("sidebar__chevron--collapsed");
            btn.setAttribute("aria-expanded", "true");
            sidebarState[groupLabel] = true;
          }
          saveSidebarState(sidebarState);
        });
      });

      // === Sidebar toggle ===
      const sidebarToggle = document.getElementById("sidebar-toggle");
      const sidebar = document.getElementById("atlas-sidebar");
      const sidebarBackdrop = document.getElementById("sidebar-backdrop");

      function isMobile() {
        return window.innerWidth < 1024;
      }

      function toggleSidebar() {
        if (isMobile()) {
          // Mobile: overlay open/close
          const isOpen = sidebar?.classList.contains("atlas-sidebar--open");
          if (isOpen) {
            sidebar?.classList.remove("atlas-sidebar--open");
            sidebarBackdrop?.classList.remove("sidebar-backdrop--visible");
            sidebarToggle?.setAttribute("aria-expanded", "false");
          } else {
            sidebar?.classList.add("atlas-sidebar--open");
            sidebarBackdrop?.classList.add("sidebar-backdrop--visible");
            sidebarToggle?.setAttribute("aria-expanded", "true");
          }
        } else {
          // Desktop: slide in/out
          const isClosed = sidebar?.classList.contains("atlas-sidebar--closed");
          if (isClosed) {
            sidebar?.classList.remove("atlas-sidebar--closed");
            sidebarToggle?.setAttribute("aria-expanded", "true");
          } else {
            sidebar?.classList.add("atlas-sidebar--closed");
            sidebarToggle?.setAttribute("aria-expanded", "false");
          }
        }
      }

      sidebarToggle?.addEventListener("click", toggleSidebar);
      sidebarBackdrop?.addEventListener("click", () => {
        sidebar?.classList.remove("atlas-sidebar--open");
        sidebarBackdrop?.classList.remove("sidebar-backdrop--visible");
        sidebarToggle?.setAttribute("aria-expanded", "false");
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && isMobile()) {
          sidebar?.classList.remove("atlas-sidebar--open");
          sidebarBackdrop?.classList.remove("sidebar-backdrop--visible");
          sidebarToggle?.setAttribute("aria-expanded", "false");
        }
      });

      // === Auth state check via Better Auth API ===
      (async function checkAuth() {
        const AUTH_URL = import.meta.env.PUBLIC_AUTH_BASE_URL || "https://ep-steep-art-aol3cqdt.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth";
        try {
          const res = await fetch(`${AUTH_URL}/get-session`, {
            credentials: "include",
            headers: { "Accept": "application/json" }
          });
          if (res.ok) {
            const data = await res.json();
            if (data?.user || data?.session) {
              document.getElementById("auth-buttons")?.style.setProperty("display", "none");
              document.getElementById("auth-user")?.style.removeProperty("display");
            }
          }
        } catch (e) {
          // Not logged in or error
        }
      })();

      // === Search trigger ===
      document.getElementById("search-trigger")?.addEventListener("click", () => {
        window.dispatchEvent(new KeyboardEvent("keydown", { key: "k", ctrlKey: true, bubbles: true }));
      });

      // === Header subtle shadow on scroll ===
      const topnav = document.getElementById("topnav");
      if (topnav) {
        const scrollThreshold = 10;
        let ticking = false;
        function onScroll() {
          if (!ticking) {
            requestAnimationFrame(() => {
              topnav.classList.toggle("topnav--scrolled", window.scrollY > scrollThreshold);
              ticking = false;
            });
            ticking = true;
          }
        }
        window.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
      }

      // === Scroll progress bar ===
      const progressBar = document.getElementById("scroll-progress");
      if (progressBar) {
        let progressTicking = false;
        function updateProgress() {
          if (!progressTicking) {
            requestAnimationFrame(() => {
              const scrollTop = window.scrollY;
              const docHeight = document.documentElement.scrollHeight - window.innerHeight;
              const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
              progressBar.style.width = pct + "%";
              progressTicking = false;
            });
            progressTicking = true;
          }
        }
        window.addEventListener("scroll", updateProgress, { passive: true });
        updateProgress();
      }

      // === Heading border reveal on scroll ===
      function initHeadingReveal() {
        const headings = document.querySelectorAll<HTMLElement>(".prose h2, .prose h3");
        if (!headings.length) return;

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("heading-visible");
              }
            }
          },
          { rootMargin: "-40px 0px -60% 0px", threshold: 0 }
        );

        headings.forEach((h) => observer.observe(h));

        document.addEventListener("astro:before-swap", () => observer.disconnect(), { once: true });
      }
      initHeadingReveal();
      document.addEventListener("astro:after-swap", initHeadingReveal);

      // === Keyboard shortcuts overlay ===
      const shortcutsOverlay = document.getElementById("shortcuts-overlay");
      const shortcutsClose = document.getElementById("shortcuts-close");

      function openShortcuts() {
        if (shortcutsOverlay) shortcutsOverlay.hidden = false;
      }
      function closeShortcuts() {
        if (shortcutsOverlay) shortcutsOverlay.hidden = true;
      }

      shortcutsClose?.addEventListener("click", closeShortcuts);
      shortcutsOverlay?.addEventListener("click", (e) => {
        if (e.target === shortcutsOverlay) closeShortcuts();
      });

      document.addEventListener("keydown", (e) => {
        // "?" to open shortcuts (when not in an input)
        if (
          e.key === "?" &&
          !e.ctrlKey &&
          !e.metaKey &&
          !e.altKey &&
          !(e.target instanceof HTMLInputElement) &&
          !(e.target instanceof HTMLTextAreaElement) &&
          !(e.target instanceof HTMLSelectElement)
        ) {
          e.preventDefault();
          openShortcuts();
        }
        // Esc to close shortcuts
        if (e.key === "Escape" && shortcutsOverlay && !shortcutsOverlay.hidden) {
          closeShortcuts();
        }
      });
    </script>
  </body>
</html>
