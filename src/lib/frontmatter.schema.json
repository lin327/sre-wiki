{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SRE Atlas frontmatter v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "created",
    "updated",
    "sources",
    "canonical",
    "domain",
    "type",
    "confidence",
    "tags"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "title"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "canonical": {
      "type": "boolean"
    },
    "reviewed": {
      "type": "boolean"
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date"
    },
    "category": {
      "type": "string",
      "deprecated": true,
      "enum": [
        "linux",
        "docker",
        "kubernetes",
        "runbooks",
        "architectures",
        "incidents",
        "comparisons"
      ]
    },
    "domain": {
      "type": "string",
      "enum": [
        "observability",
        "kubernetes",
        "container-runtime",
        "docker",
        "linux",
        "iac",
        "security",
        "chaos-engineering",
        "ai",
        "tbd"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "concept",
        "guide",
        "runbook",
        "incident",
        "architecture",
        "comparison",
        "news"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "if": {
    "properties": { "canonical": { "const": true } },
    "required": ["canonical"]
  },
  "then": {
    "required": ["reviewed", "reviewed_by", "reviewed_at"],
    "properties": {
      "domain": { "not": { "const": "tbd" } },
      "reviewed": { "const": true }
    }
  },
  "$defs": {
    "canonicalBody": {
      "type": "string",
      "minLength": 800,
      "pattern": "^(?![\\s\\S]*内容待补充)[\\s\\S]*$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,58}[a-z0-9]$"
    }
  }
}
