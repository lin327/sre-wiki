---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Use import.meta.glob for Astro 6
const articleModules = import.meta.glob('./*.mdx', { eager: true });

interface Article {
  title: string;
  href: string;
  category: string;
  confidence: string;
}

const articles: Article[] = [];

for (const [path, mod] of Object.entries(articleModules)) {
  const fm = (mod as any)?.frontmatter;
  if (!fm) continue;
  const slug = path.replace('./', '').replace('.mdx', '');
  articles.push({
    title: fm.title || slug,
    href: `/articles/${slug}`,
    category: fm.category || 'uncategorized',
    confidence: fm.confidence || 'medium',
  });
}

articles.sort((a, b) => a.title.localeCompare(b.title, 'zh'));

// Group by category
const grouped: Record<string, Article[]> = {};
for (const article of articles) {
  const cat = article.category || 'uncategorized';
  if (!grouped[cat]) grouped[cat] = [];
  grouped[cat].push(article);
}

const categories = Object.keys(grouped).sort();
---

<BaseLayout title="Articles" description="Agent 采集的 SRE 知识文章">
  <section class="articles-header">
    <h1 class="articles-title">Articles</h1>
    <p class="articles-desc">
      Agent 自动采集并生成的 SRE 知识文章，共 {articles.length} 篇。
    </p>
  </section>

  <div class="articles-stats">
    <span class="articles-stats__item">{articles.length} articles</span>
    <span class="articles-stats__sep">·</span>
    <span class="articles-stats__item">{categories.length} categories</span>
  </div>

  {categories.map((cat) => (
    <section class="articles-category">
      <h2 class="articles-category__title">{cat} <span class="articles-category__count">{grouped[cat].length}</span></h2>
      <ul class="articles-list">
        {grouped[cat].map((article) => (
          <li class="articles-item">
            <a href={article.href} class="articles-link">
              <span class="articles-link__title">{article.title}</span>
              <span class="articles-link__confidence" data-confidence={article.confidence}>{article.confidence}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

<style>
  .articles-header {
    padding: 0 0 20px;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 16px;
  }

  .articles-title {
    font-size: 24px;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 8px;
  }

  .articles-desc {
    font-size: 14px;
    color: var(--color-muted);
    margin: 0;
  }

  .articles-stats {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 0 20px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-dim);
  }

  .articles-stats__sep {
    color: var(--color-border);
  }

  .articles-category {
    margin-bottom: 28px;
  }

  .articles-category__title {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 8px;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .articles-category__count {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--color-dim);
    background: var(--color-surface-2);
    padding: 1px 6px;
    border-radius: 10px;
  }

  .articles-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .articles-item {
    border-bottom: 1px solid var(--color-border);
  }
  .articles-item:last-child {
    border-bottom: none;
  }

  .articles-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 8px 12px;
    text-decoration: none;
    color: inherit;
    transition: background 100ms ease;
  }
  .articles-link:hover {
    background: var(--color-surface-2);
    text-decoration: none;
  }

  .articles-link__title {
    font-size: 13px;
    color: var(--color-ink);
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .articles-link:hover .articles-link__title {
    color: var(--color-primary);
  }

  .articles-link__confidence {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    padding: 1px 6px;
    border-radius: 10px;
    background: var(--color-surface-2);
    color: var(--color-dim);
  }
  .articles-link__confidence[data-confidence="high"] {
    background: oklch(0.550 0.160 145 / 0.1);
    color: oklch(0.450 0.140 145);
  }
  .articles-link__confidence[data-confidence="low"] {
    background: oklch(0.700 0.150 75 / 0.1);
    color: oklch(0.500 0.120 75);
  }
</style>
