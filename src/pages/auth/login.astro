---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="登录" description="登录 SRE Atlas">
  <div class="login-container">
    <div class="login-card">
      <h1 class="login-title">登录 SRE Atlas</h1>
      <p class="login-desc">使用邮箱密码登录，或联系管理员开通账号。</p>

      <form id="login-form" class="login-form">
        <div class="login-field">
          <label for="email" class="login-label">邮箱</label>
          <input type="email" id="email" name="email" class="login-input" placeholder="your@email.com" required />
        </div>
        <div class="login-field">
          <label for="password" class="login-label">密码</label>
          <input type="password" id="password" name="password" class="login-input" placeholder="••••••••" required />
        </div>
        <button type="submit" class="login-submit" id="login-btn">登录</button>
        <div id="login-error" class="login-error" hidden></div>
      </form>

      <div class="login-divider">
        <span class="login-divider-text">或</span>
      </div>

      <button type="button" id="github-btn" class="login-github">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
        使用 GitHub 登录
      </button>

      <div class="login-divider">
        <span class="login-divider-text">或</span>
      </div>

      <div class="login-register">
        还没有账号？<a href="/auth/register" class="login-link">注册</a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { authClient } from "../../lib/auth-client";

  const form = document.getElementById("login-form") as HTMLFormElement;
  const errorEl = document.getElementById("login-error") as HTMLDivElement;
  const btn = document.getElementById("login-btn") as HTMLButtonElement;

  // GitHub OAuth
  document.getElementById("github-btn")?.addEventListener("click", async () => {
    await authClient.signIn.social({
      provider: "github",
      callbackURL: "/",
    });
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorEl.hidden = true;
    btn.textContent = "登录中...";
    btn.disabled = true;

    const email = (document.getElementById("email") as HTMLInputElement).value;
    const password = (document.getElementById("password") as HTMLInputElement).value;

    try {
      const res = await authClient.signIn.email({
        email,
        password,
      });

      if (res.error) {
        errorEl.textContent = res.error.message || "登录失败，请检查邮箱和密码";
        errorEl.hidden = false;
        btn.textContent = "登录";
        btn.disabled = false;
      } else {
        window.location.href = "/";
      }
    } catch (err: any) {
      errorEl.textContent = err.message || "登录失败";
      errorEl.hidden = false;
      btn.textContent = "登录";
      btn.disabled = false;
    }
  });
</script>

<style>
  .login-container {
    display: flex;
    justify-content: center;
    padding: 64px 16px;
  }

  .login-card {
    width: 100%;
    max-width: 380px;
    padding: 32px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  .login-title {
    font-size: 20px;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 8px;
  }

  .login-desc {
    font-size: 13px;
    color: var(--color-dim);
    margin: 0 0 24px;
  }

  .login-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .login-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .login-label {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-ink);
  }

  .login-input {
    height: 36px;
    padding: 0 10px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
    color: var(--color-ink);
    font-size: 13px;
    outline: none;
    transition: border-color 100ms ease;
  }

  .login-input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px oklch(0.480 0.170 250 / 0.12);
  }

  .login-submit {
    height: 36px;
    border: none;
    border-radius: 6px;
    background: var(--color-primary);
    color: #fff;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 100ms ease;
  }

  .login-submit:hover {
    opacity: 0.9;
  }

  .login-submit:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .login-error {
    padding: 8px 12px;
    border: 1px solid var(--color-error);
    border-radius: 6px;
    background: oklch(0.550 0.200 25 / 0.08);
    color: var(--color-error);
    font-size: 12px;
  }

  .login-divider {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 24px 0;
  }

  .login-divider::before,
  .login-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--color-border);
  }

  .login-divider-text {
    font-size: 11px;
    color: var(--color-dim);
  }

  .login-register {
    text-align: center;
    font-size: 13px;
    color: var(--color-dim);
  }

  .login-link {
    color: var(--color-primary);
    text-decoration: none;
  }

  .login-link:hover {
    text-decoration: underline;
  }

  .login-github {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    height: 36px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-surface);
    color: var(--color-ink);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: background 100ms ease;
  }

  .login-github:hover {
    background: var(--color-surface-2);
  }
</style>
