---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Continued" description="Continued · a guide for students in computer-related majors and new industry entrants">
  <section class="welcome">
    <h1 class="welcome__title">Continued</h1>
    <p class="welcome__desc">
      Continued · 计算机入行指南. A guide for students in computer-related majors and people new to the industry.
    </p>
  </section>

  <div class="stats-row">
    <span class="stats-row__item">21 pages</span>
    <span class="stats-row__sep">·</span>
    <span class="stats-row__item">7 categories</span>
    <span class="stats-row__sep">·</span>
    <span class="stats-row__item">Updated today</span>
  </div>

  <section class="categories">
    <h2 class="section-title">Quick access</h2>
    <div class="categories__grid">
      <a href="/en/linux/process-model" class="card-link category-card">
        <div class="category-card__header">
          <h3 class="category-card__title">Linux</h3>
          <span class="category-card__count">4</span>
        </div>
        <p class="category-card__latest">Latest: Process Model</p>
      </a>
      <a href="/en/docker/image-layers" class="card-link category-card">
        <div class="category-card__header">
          <h3 class="category-card__title">Docker</h3>
          <span class="category-card__count">4</span>
        </div>
        <p class="category-card__latest">Latest: Image Layers</p>
      </a>
      <a href="/en/kubernetes/pod-lifecycle" class="card-link category-card">
        <div class="category-card__header">
          <h3 class="category-card__title">Kubernetes</h3>
          <span class="category-card__count">3</span>
        </div>
        <p class="category-card__latest">Latest: Pod Lifecycle</p>
      </a>
      <a href="/en/runbooks/crashloopbackoff" class="card-link category-card">
        <div class="category-card__header">
          <h3 class="category-card__title">Runbooks</h3>
          <span class="category-card__count">3</span>
        </div>
        <p class="category-card__latest">Latest: CrashLoopBackOff</p>
      </a>
    </div>
  </section>
</BaseLayout>
