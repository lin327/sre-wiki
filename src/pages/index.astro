---
import BaseLayout from "../layouts/BaseLayout.astro";

interface CategoryCard {
  title: string;
  href: string;
  icon: string;
  count: number;
  latest: string;
  latestHref: string;
  color: string;
}

interface RecentPage {
  title: string;
  href: string;
  category: string;
  categoryColor: string;
  icon: string;
}

const categoryCards: CategoryCard[] = [
  {
    title: "Linux",
    href: "/linux/process-model",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2Zm2 .5v11a.5.5 0 0 0 .5.5h11a.5.5 0 0 0 .5-.5v-11a.5.5 0 0 0-.5-.5h-11a.5.5 0 0 0-.5.5ZM4 5h8v1H4V5Zm0 3h6v1H4V8Z"/></svg>`,
    count: 4,
    latest: "systemd 服务管理",
    latestHref: "/linux/systemd",
    color: "var(--color-success)",
  },
  {
    title: "Docker",
    href: "/docker/image-layers",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M13.02 7.222c-.012-.06-.028-.118-.046-.176l.003.012c-.088-.44-.39-.81-.81-1.047a1.7 1.7 0 0 0-.846-.21H9.13c-.16-.6-.45-1.13-.84-1.55C7.46 3.43 6.34 3 5.14 3c-.8 0-1.58.2-2.12.55A2.16 2.16 0 0 0 2 5.5c0 .4.1.78.32 1.12.2.3.48.54.8.7-.04.06-.07.14-.1.2C2.35 7.87 2 8.48 2 9.22c0 1.26.75 2.28 2.12 2.85.97.4 2.17.58 3.38.58.4 0 .8-.02 1.18-.07.48-.06.93-.18 1.34-.36.65-.29 1.18-.74 1.55-1.3.17-.25.3-.52.38-.8.14-.02.28-.06.4-.1.35-.13.64-.32.86-.57.2-.22.35-.5.44-.8.06-.2.1-.4.1-.62 0-.28-.06-.54-.16-.78a1.7 1.7 0 0 0-.4-.58c.08-.16.14-.34.18-.52.06-.2.08-.58.04-.88ZM3 6.5c0-.46.2-.86.52-1.14.3-.26.68-.36 1.02-.36.46 0 .92.16 1.3.44.3.24.52.56.62.92H3Zm3.38 5.44c-.78 0-1.58-.1-2.3-.34-1.06-.34-1.5-.86-1.5-1.58 0-.44.16-.82.44-1.12.28-.3.64-.48 1.08-.56.2-.04.42-.06.64-.08h5.88c-.12.44-.34.84-.66 1.16-.4.4-.9.66-1.46.78-.34.08-.7.12-1.06.12l-1.6.02ZM14 5.5h-1.5V4h-1v1.5H10v1h1.5V8h1V6.5H14v-1Z"/></svg>`,
    count: 4,
    latest: "Docker 存储驱动",
    latestHref: "/docker/storage",
    color: "var(--color-info)",
  },
  {
    title: "Kubernetes",
    href: "/kubernetes/pod-lifecycle",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0Zm3.67 11.36-4.67 2.7a.5.5 0 0 1-.5 0l-4.67-2.7a.5.5 0 0 1-.25-.43V5.07a.5.5 0 0 1 .25-.43l4.67-2.7a.5.5 0 0 1 .5 0l4.67 2.7a.5.5 0 0 1 .25.43v5.86a.5.5 0 0 1-.25.43ZM8 1.4 3.8 3.8v6.4L8 12.6l4.2-2.4V3.8L8 1.4Z"/><path d="M8 5a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm0 1a2 2 0 1 1 0 4 2 2 0 0 1 0-4Z"/></svg>`,
    count: 3,
    latest: "Service Mesh 架构对比",
    latestHref: "/kubernetes/service-mesh",
    color: "var(--color-primary)",
  },
  {
    title: "Runbooks",
    href: "/runbooks/crashloopbackoff",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.5a.5.5 0 0 1 .5.5v5.793l2.146-2.147a.5.5 0 0 1 .708.708l-3 3a.5.5 0 0 1-.708 0l-3-3a.5.5 0 1 1 .708-.708L7.5 7.793V2a.5.5 0 0 1 .5-.5Z"/><path d="M2 12.5a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5Z"/></svg>`,
    count: 3,
    latest: "OOMKilled 排查",
    latestHref: "/runbooks/oomkilled",
    color: "var(--color-error)",
  },
];

const recentPages: RecentPage[] = [
  { title: "Service Mesh 架构对比", href: "/kubernetes/service-mesh", category: "Kubernetes", categoryColor: "var(--color-primary)", icon: `<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0Zm3.67 11.36-4.67 2.7a.5.5 0 0 1-.5 0l-4.67-2.7a.5.5 0 0 1-.25-.43V5.07a.5.5 0 0 1 .25-.43l4.67-2.7a.5.5 0 0 1 .5 0l4.67 2.7a.5.5 0 0 1 .25.43v5.86a.5.5 0 0 1-.25.43ZM8 1.4 3.8 3.8v6.4L8 12.6l4.2-2.4V3.8L8 1.4Z"/></svg>` },
  { title: "GitOps Pipeline 实践", href: "/architectures/gitops-pipeline", category: "Architecture", categoryColor: "var(--color-accent)", icon: `<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M6 1a1 1 0 0 0-1 1v2H3a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h2v2a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V8h2a1 1 0 0 0 1-1V5a1 1 0 0 0-1-1h-2V2a1 1 0 0 0-1-1H6Zm0 1h4v2h2v2h-2v4H8V6H6V4h2V2Z"/></svg>` },
  { title: "DNS 解析故障排查", href: "/incidents/dns-resolution-failure", category: "Incident", categoryColor: "var(--color-error)", icon: `<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M9.405 1.05c-.413-1.4-2.397-1.4-2.81 0l-.1.34a1.464 1.464 0 0 1-2.105.872l-.31-.17c-1.283-.698-2.686.705-1.987 1.987l.169.311c.446.82.023 1.841-.872 2.105l-.34.1c-1.4.413-1.4 2.397 0 2.81l.34.1a1.464 1.464 0 0 1 .872 2.105l-.17.31c-.698 1.283.705 2.686 1.987 1.987l.311-.169a1.464 1.464 0 0 1 2.105.872l.1.34c.413 1.4 2.397 1.4 2.81 0l.1-.34a1.464 1.464 0 0 1 2.105-.872l.31.17c1.283.698 2.686-.705 1.987-1.987l-.169-.311a1.464 1.464 0 0 1 .872-2.105l.34-.1c1.4-.413 1.4-2.397 0-2.81l-.34-.1a1.464 1.464 0 0 1-.872-2.105l.17-.31c.698-1.283-.705-2.686-1.987-1.987l-.311.169a1.464 1.464 0 0 1-2.105-.872l-.1-.34ZM8 10.93a2.929 2.929 0 1 1 0-5.86 2.929 2.929 0 0 1 0 5.858Z"/></svg>` },
  { title: "Helm vs Kustomize", href: "/comparisons/helm-vs-kustomize", category: "Comparison", categoryColor: "var(--color-warning)", icon: `<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M6 12.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5ZM3 8.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5Zm0-4a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 0 1h-9a.5.5 0 0 1-.5-.5Z"/></svg>` },
  { title: "Docker 存储驱动", href: "/docker/storage", category: "Docker", categoryColor: "var(--color-info)", icon: `<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M13.02 7.222c-.012-.06-.028-.118-.046-.176l.003.012c-.088-.44-.39-.81-.81-1.047a1.7 1.7 0 0 0-.846-.21H9.13c-.16-.6-.45-1.13-.84-1.55C7.46 3.43 6.34 3 5.14 3c-.8 0-1.58.2-2.12.55A2.16 2.16 0 0 0 2 5.5c0 .4.1.78.32 1.12.2.3.48.54.8.7-.04.06-.07.14-.1.2C2.35 7.87 2 8.48 2 9.22c0 1.26.75 2.28 2.12 2.85.97.4 2.17.58 3.38.58.4 0 .8-.02 1.18-.07.48-.06.93-.18 1.34-.36.65-.29 1.18-.74 1.55-1.3.17-.25.3-.52.38-.8.14-.02.28-.06.4-.1.35-.13.64-.32.86-.57.2-.22.35-.5.44-.8.06-.2.1-.4.1-.62 0-.28-.06-.54-.16-.78a1.7 1.7 0 0 0-.4-.58c.08-.16.14-.34.18-.52.06-.28.08-.58.04-.88ZM3 6.5c0-.46.2-.86.52-1.14.3-.26.68-.36 1.02-.36.46 0 .92.16 1.3.44.3.24.52.56.62.92H3Zm3.38 5.44c-.78 0-1.58-.1-2.3-.34-1.06-.34-1.5-.86-1.5-1.58 0-.44.16-.82.44-1.12.28-.3.64-.48 1.08-.56.2-.04.42-.06.64-.08h5.88c-.12.44-.34.84-.66 1.16-.4.4-.9.66-1.46.78-.34.08-.7.12-1.06.12l-1.6.02ZM14 5.5h-1.5V4h-1v1.5H10v1h1.5V8h1V6.5H14v-1Z"/></svg>` },
  { title: "systemd 服务管理", href: "/linux/systemd", category: "Linux", categoryColor: "var(--color-success)", icon: `<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2Zm2 .5v11a.5.5 0 0 0 .5.5h11a.5.5 0 0 0 .5-.5v-11a.5.5 0 0 0-.5-.5h-11a.5.5 0 0 0-.5.5ZM4 5h8v1H4V5Zm0 3h6v1H4V8Z"/></svg>` },
];
---

<BaseLayout title="SRE Atlas" description="SRE 运维知识库，覆盖 Linux、Docker、Kubernetes 全链路">
  {/* Welcome Banner */}
  <section class="welcome" aria-labelledby="welcome-title">
    <h1 id="welcome-title" class="welcome__title">Welcome to SRE Atlas</h1>
    <p class="welcome__desc">
      AI 驱动的运维知识库，覆盖 Linux、Docker、Kubernetes 全链路。快速查阅故障排查流程、技术架构对比与最佳实践。
    </p>
  </section>

  {/* Stats Row — GitHub repo stats style */}
  <div class="stats-row" aria-label="Site statistics">
    <span class="stats-row__item">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h11A1.5 1.5 0 0 1 15 2.5v11a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 1 13.5v-11ZM2.5 2a.5.5 0 0 0-.5.5v11a.5.5 0 0 0 .5.5h11a.5.5 0 0 0 .5-.5v-11a.5.5 0 0 0-.5-.5h-11Z"/></svg>
      21 pages
    </span>
    <span class="stats-row__sep" aria-hidden="true">·</span>
    <span class="stats-row__item">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M0 2a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2Zm6 0a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1H6Z"/></svg>
      7 categories
    </span>
    <span class="stats-row__sep" aria-hidden="true">·</span>
    <span class="stats-row__item">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 3.5a.5.5 0 0 0-1 0V8a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 7.71V3.5Z"/><path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16Zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/></svg>
      Updated today
    </span>
  </div>

  {/* Quick Access Grid — category cards */}
  <section class="categories" aria-labelledby="categories-heading">
    <h2 id="categories-heading" class="section-title">Quick access</h2>
    <div class="categories__grid">
      {categoryCards.map((card) => (
        <a href={card.href} class="card-link category-card">
          <div class="category-card__header">
            <span class="category-card__icon" style={`color:${card.color}`}>
              <Fragment set:html={card.icon} />
            </span>
            <h3 class="category-card__title">{card.title}</h3>
            <span class="category-card__count">{card.count}</span>
          </div>
          <p class="category-card__latest">
            Latest: <span class="category-card__latest-link">{card.latest}</span>
          </p>
        </a>
      ))}
    </div>
  </section>

  {/* Recent Activity Feed — GitHub activity style */}
  <section class="activity" aria-labelledby="activity-heading">
    <h2 id="activity-heading" class="section-title">Recent activity</h2>
    <ul class="activity__list">
      {recentPages.map((page) => (
        <li class="activity__item">
          <a href={page.href} class="activity__link">
            <span class="activity__icon" style={`color:${page.categoryColor}`}>
              <Fragment set:html={page.icon} />
            </span>
            <span class="activity__title">{page.title}</span>
            <span class="activity__badge" style={`--badge-color:${page.categoryColor}`}>{page.category}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  /* ============================================
     Welcome Banner
     ============================================ */
  .welcome {
    padding: 32px 0 24px;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 24px;
  }

  .welcome__title {
    font-size: 24px;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 8px;
    letter-spacing: -0.02em;
  }

  .welcome__desc {
    font-size: 14px;
    color: var(--color-muted);
    margin: 0;
    max-width: 640px;
    line-height: 1.6;
  }

  /* ============================================
     Stats Row — monospace, muted, GitHub-style
     ============================================ */
  .stats-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    padding: 0 0 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-dim);
  }

  .stats-row__item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .stats-row__sep {
    color: var(--color-border);
  }

  /* ============================================
     Section Title
     ============================================ */
  .section-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-border);
  }

  /* ============================================
     Category Cards Grid
     ============================================ */
  .categories {
    margin-bottom: 32px;
  }

  .categories__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  @media (max-width: 639px) {
    .categories__grid {
      grid-template-columns: 1fr;
    }
  }

  .category-card {
    display: block;
    padding: 16px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition:
      box-shadow var(--motion-normal) ease,
      border-color var(--motion-normal) ease;
  }

  .category-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
    text-decoration: none;
  }

  .category-card__header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .category-card__icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .category-card__title {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0;
    flex: 1;
  }

  .category-card__count {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--color-dim);
    background: var(--color-surface-2);
    padding: 1px 6px;
    border-radius: 10px;
    flex-shrink: 0;
  }

  .category-card__latest {
    font-size: 12px;
    color: var(--color-dim);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .category-card__latest-link {
    color: var(--color-primary-l);
  }

  /* ============================================
     Activity Feed
     ============================================ */
  .activity {
    margin-bottom: 32px;
  }

  .activity__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .activity__item {
    border-bottom: 1px solid var(--color-border);
  }

  .activity__item:last-child {
    border-bottom: none;
  }

  .activity__link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    text-decoration: none;
    color: inherit;
    transition: background var(--motion-fast) ease;
  }

  .activity__link:hover {
    background: var(--color-surface-2);
    text-decoration: none;
  }

  .activity__icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .activity__title {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-ink);
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .activity__link:hover .activity__title {
    color: var(--color-primary-l);
  }

  .activity__badge {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    padding: 1px 8px;
    border-radius: 10px;
    color: var(--badge-color, var(--color-muted));
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
  }

  /* ============================================
     Reduced Motion
     ============================================ */
  @media (prefers-reduced-motion: reduce) {
    .category-card,
    .activity__link {
      transition: none;
    }
  }
</style>
