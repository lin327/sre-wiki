---
import BaseLayout from "../layouts/BaseLayout.astro";

interface CategoryCard {
  title: string;
  href: string;
  icon: string;
  count: number;
  latest: string;
  latestHref: string;
  color: string;
}

interface RecentPage {
  title: string;
  href: string;
  category: string;
  categoryColor: string;
  icon: string;
}

const categoryCards: CategoryCard[] = [
  {
    title: "Linux",
    href: "/linux/process-model",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h9A1.5 1.5 0 0 1 14 3.5v9a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 12.5v-9ZM3.5 3a.5.5 0 0 0-.5.5v9a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5v-9a.5.5 0 0 0-.5-.5h-9ZM5 5.5A.5.5 0 0 1 5.5 5h5a.5.5 0 0 1 0 1h-5A.5.5 0 0 1 5 5.5Zm0 3A.5.5 0 0 1 5.5 8h5a.5.5 0 0 1 0 1h-5A.5.5 0 0 1 5 8.5Zm0 3a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5Z"/></svg>`,
    count: 4,
    latest: "systemd 服务管理",
    latestHref: "/linux/systemd",
    color: "var(--color-success)",
  },
  {
    title: "Docker",
    href: "/docker/image-layers",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M1.5 6.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-.5.5H2a.5.5 0 0 1-.5-.5v-3Zm2-1a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-4Zm2-1a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v5a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-5Zm2 0a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v5a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-5Zm2 1a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-4Z"/></svg>`,
    count: 4,
    latest: "Docker 存储驱动",
    latestHref: "/docker/storage",
    color: "var(--color-info)",
  },
  {
    title: "Kubernetes",
    href: "/kubernetes/pod-lifecycle",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm6.5-2.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5V8h2.5a.5.5 0 0 1 0 1H8.5v2.5a.5.5 0 0 1-1 0V9H5a.5.5 0 0 1 0-1h2.5V5.5Z"/></svg>`,
    count: 3,
    latest: "Service Mesh 架构对比",
    latestHref: "/kubernetes/service-mesh",
    color: "var(--color-primary)",
  },
  {
    title: "Runbooks",
    href: "/runbooks/crashloopbackoff",
    icon: `<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h11A1.5 1.5 0 0 1 15 2.5v11a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 1 13.5v-11ZM2.5 2a.5.5 0 0 0-.5.5v11a.5.5 0 0 0 .5.5h11a.5.5 0 0 0 .5-.5v-11a.5.5 0 0 0-.5-.5h-11ZM5 4.5A.5.5 0 0 1 5.5 4h5a.5.5 0 0 1 0 1h-5A.5.5 0 0 1 5 4.5Zm0 3A.5.5 0 0 1 5.5 7h5a.5.5 0 0 1 0 1h-5A.5.5 0 0 1 5 7.5Zm0 3a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5Z"/></svg>`,
    count: 3,
    latest: "OOMKilled 排查",
    latestHref: "/runbooks/oomkilled",
    color: "var(--color-error)",
  },
];

const recentPages: RecentPage[] = [
  { title: "Service Mesh 架构对比", href: "/kubernetes/service-mesh", category: "Kubernetes", categoryColor: "var(--color-primary)", icon: `<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm6.5-2.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5V8h2.5a.5.5 0 0 1 0 1H8.5v2.5a.5.5 0 0 1-1 0V9H5a.5.5 0 0 1 0-1h2.5V5.5Z"/></svg>` },
  { title: "GitOps Pipeline 实践", href: "/architectures/gitops-pipeline", category: "Architecture", categoryColor: "var(--color-accent)", icon: `<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.5a.5.5 0 0 1 .5.5v4.293l2.146-2.147a.5.5 0 0 1 .708.708L8.707 7.5l2.647 2.646a.5.5 0 0 1-.708.708L8.5 8.707V13a.5.5 0 0 1-1 0V8.707L5.354 10.854a.5.5 0 1 1-.708-.708L7.293 7.5 4.646 4.854a.5.5 0 1 1 .708-.708L7.5 6.293V2a.5.5 0 0 1 .5-.5Z"/></svg>` },
  { title: "DNS 解析故障排查", href: "/incidents/dns-resolution-failure", category: "Incident", categoryColor: "var(--color-error)", icon: `<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566ZM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5Zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z"/></svg>` },
  { title: "Helm vs Kustomize", href: "/comparisons/helm-vs-kustomize", category: "Comparison", categoryColor: "var(--color-warning)", icon: `<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M0 2a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2Zm6 0a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1H6Z"/></svg>` },
  { title: "Docker 存储驱动", href: "/docker/storage", category: "Docker", categoryColor: "var(--color-info)", icon: `<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M1.5 6.5a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v3a.5.5 0 0 1-.5.5H2a.5.5 0 0 1-.5-.5v-3Zm2-1a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v4a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-4Zm2-1a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 .5.5v5a.5.5 0 0 1-.5.5h-1a.5.5 0 0 1-.5-.5v-5Z"/></svg>` },
  { title: "systemd 服务管理", href: "/linux/systemd", category: "Linux", categoryColor: "var(--color-success)", icon: `<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M2 3.5A1.5 1.5 0 0 1 3.5 2h9A1.5 1.5 0 0 1 14 3.5v9a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 12.5v-9ZM3.5 3a.5.5 0 0 0-.5.5v9a.5.5 0 0 0 .5.5h9a.5.5 0 0 0 .5-.5v-9a.5.5 0 0 0-.5-.5h-9ZM5 5.5A.5.5 0 0 1 5.5 5h5a.5.5 0 0 1 0 1h-5A.5.5 0 0 1 5 5.5Zm0 3A.5.5 0 0 1 5.5 8h5a.5.5 0 0 1 0 1h-5A.5.5 0 0 1 5 8.5Z"/></svg>` },
];
---

<BaseLayout title="SRE Atlas" description="SRE 运维知识库，覆盖 Linux、Docker、Kubernetes 全链路">
  {/* Welcome Banner */}
  <section class="welcome" aria-labelledby="welcome-title">
    <h1 id="welcome-title" class="welcome__title">Welcome to SRE Atlas</h1>
    <p class="welcome__desc">
      AI 驱动的运维知识库，覆盖 Linux、Docker、Kubernetes 全链路。快速查阅故障排查流程、技术架构对比与最佳实践。
    </p>
  </section>

  {/* Stats Row — GitHub repo stats style */}
  <div class="stats-row" aria-label="Site statistics">
    <span class="stats-row__item">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M1 2.5A1.5 1.5 0 0 1 2.5 1h11A1.5 1.5 0 0 1 15 2.5v11a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 1 13.5v-11ZM2.5 2a.5.5 0 0 0-.5.5v11a.5.5 0 0 0 .5.5h11a.5.5 0 0 0 .5-.5v-11a.5.5 0 0 0-.5-.5h-11Z"/></svg>
      21 pages
    </span>
    <span class="stats-row__sep" aria-hidden="true">·</span>
    <span class="stats-row__item">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M0 2a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2Zm6 0a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h4a1 1 0 0 0 1-1V3a1 1 0 0 0-1-1H6Z"/></svg>
      7 categories
    </span>
    <span class="stats-row__sep" aria-hidden="true">·</span>
    <span class="stats-row__item">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 3.5a.5.5 0 0 0-1 0V8a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 7.71V3.5Z"/><path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16Zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/></svg>
      Updated today
    </span>
  </div>

  {/* Quick Access Grid — category cards */}
  <section class="categories" aria-labelledby="categories-heading">
    <h2 id="categories-heading" class="section-title">Quick access</h2>
    <div class="categories__grid">
      {categoryCards.map((card) => (
        <a href={card.href} class="card-link category-card">
          <div class="category-card__header">
            <span class="category-card__icon" style={`color:${card.color}`}>
              <Fragment set:html={card.icon} />
            </span>
            <h3 class="category-card__title">{card.title}</h3>
            <span class="category-card__count">{card.count}</span>
          </div>
          <p class="category-card__latest">
            Latest: <span class="category-card__latest-link">{card.latest}</span>
          </p>
        </a>
      ))}
    </div>
  </section>

  {/* Recent Activity Feed — GitHub activity style */}
  <section class="activity" aria-labelledby="activity-heading">
    <h2 id="activity-heading" class="section-title">Recent activity</h2>
    <ul class="activity__list">
      {recentPages.map((page) => (
        <li class="activity__item">
          <a href={page.href} class="activity__link">
            <span class="activity__icon" style={`color:${page.categoryColor}`}>
              <Fragment set:html={page.icon} />
            </span>
            <span class="activity__title">{page.title}</span>
            <span class="activity__badge" style={`--badge-color:${page.categoryColor}`}>{page.category}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  /* ============================================
     Welcome Banner
     ============================================ */
  .welcome {
    padding: 32px 0 24px;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 24px;
  }

  .welcome__title {
    font-size: 24px;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 8px;
    letter-spacing: -0.02em;
  }

  .welcome__desc {
    font-size: 14px;
    color: var(--color-muted);
    margin: 0;
    max-width: 640px;
    line-height: 1.6;
  }

  /* ============================================
     Stats Row — monospace, muted, GitHub-style
     ============================================ */
  .stats-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    padding: 0 0 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-dim);
  }

  .stats-row__item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .stats-row__sep {
    color: var(--color-border);
  }

  /* ============================================
     Section Title
     ============================================ */
  .section-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0 0 12px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-border);
  }

  /* ============================================
     Category Cards Grid
     ============================================ */
  .categories {
    margin-bottom: 32px;
  }

  .categories__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  @media (max-width: 639px) {
    .categories__grid {
      grid-template-columns: 1fr;
    }
  }

  .category-card {
    display: block;
    padding: 16px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition:
      box-shadow var(--motion-normal) ease,
      border-color var(--motion-normal) ease;
  }

  .category-card:hover {
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
    text-decoration: none;
  }

  .category-card__header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .category-card__icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .category-card__title {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
    margin: 0;
    flex: 1;
  }

  .category-card__count {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    color: var(--color-dim);
    background: var(--color-surface-2);
    padding: 1px 6px;
    border-radius: 10px;
    flex-shrink: 0;
  }

  .category-card__latest {
    font-size: 12px;
    color: var(--color-dim);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .category-card__latest-link {
    color: var(--color-primary-l);
  }

  /* ============================================
     Activity Feed
     ============================================ */
  .activity {
    margin-bottom: 32px;
  }

  .activity__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .activity__item {
    border-bottom: 1px solid var(--color-border);
  }

  .activity__item:last-child {
    border-bottom: none;
  }

  .activity__link {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    text-decoration: none;
    color: inherit;
    transition: background var(--motion-fast) ease;
  }

  .activity__link:hover {
    background: var(--color-surface-2);
    text-decoration: none;
  }

  .activity__icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .activity__title {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-ink);
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .activity__link:hover .activity__title {
    color: var(--color-primary-l);
  }

  .activity__badge {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    padding: 1px 8px;
    border-radius: 10px;
    color: var(--badge-color, var(--color-muted));
    background: var(--color-surface-2);
    border: 1px solid var(--color-border);
  }

  /* ============================================
     Reduced Motion
     ============================================ */
  @media (prefers-reduced-motion: reduce) {
    .category-card,
    .activity__link {
      transition: none;
    }
  }
</style>
