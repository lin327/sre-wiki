---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Pagination from "../../../components/astro/Pagination.astro";

export async function getStaticPaths() {
  const PAGE_SIZE = 20;
  const modules = import.meta.glob("../*.mdx", { eager: true });

  const articles = Object.entries(modules)
    .filter(([path]) => !path.endsWith("index.mdx"))
    .map(([path, mod]) => ({
      slug: path.split("/").pop()?.replace(".mdx", "") || "",
      title: mod.frontmatter?.title || "",
      description: mod.frontmatter?.description || "",
    }))
    .sort((a, b) => a.title.localeCompare(b.title));

  const totalPages = Math.ceil(articles.length / PAGE_SIZE);
  const paths = [];

  for (let page = 2; page <= totalPages; page++) {
    const start = (page - 1) * PAGE_SIZE;
    const end = start + PAGE_SIZE;
    const pageArticles = articles.slice(start, end);

    paths.push({
      params: { page: String(page) },
      props: {
        articles: pageArticles,
        currentPage: page,
        totalPages,
        total: articles.length,
      },
    });
  }

  return paths;
}

const { articles, currentPage, totalPages, total } = Astro.props;
const isEnglish = Astro.url.pathname.startsWith("/en/");
const basePath = "/linux";
---

<BaseLayout
  title={`Linux - ${isEnglish ? "Page" : "第"} ${currentPage}`}
  description={isEnglish ? "Process model, filesystem, network stack, systemd, observability and other core Linux knowledge." : "进程模型、文件系统、网络栈、systemd、可观测性等 Linux 核心知识。"}
>
  <section class="category-header">
    <h1 class="category-title">Linux</h1>
    <p class="category-desc">
      {isEnglish ? "Process model, filesystem, network stack, systemd, observability and other core Linux knowledge." : "进程模型、文件系统、网络栈、systemd、可观测性等 Linux 核心知识。"}
    </p>
    <div class="category-stats">
      <span class="category-stats__item">
        {isEnglish ? `${total} articles` : `共 ${total} 篇内容`}
      </span>
      <span class="category-stats__sep">·</span>
      <span class="category-stats__item">
        {isEnglish ? `Page ${currentPage} of ${totalPages}` : `第 ${currentPage} / ${totalPages} 页`}
      </span>
    </div>
  </section>

  <section class="category-articles">
    <ul class="article-list">
      {articles.map((article) => (
        <li class="article-item">
          <a href={`/linux/${article.slug}`} class="article-link">
            <span class="article-title">{article.title}</span>
            {article.description && (
              <span class="article-desc">{article.description}</span>
            )}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <Pagination
    currentPage={currentPage}
    totalPages={totalPages}
    basePath={basePath}
  />
</BaseLayout>

<style>
  .category-header {
    padding-bottom: var(--space-6);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .category-title {
    font-size: clamp(1.5rem, 1.2rem + 1.5vw, 2rem);
    font-weight: 700;
    color: var(--color-ink);
    margin: 0 0 var(--space-2);
    letter-spacing: -0.02em;
  }

  .category-desc {
    font-size: 14px;
    color: var(--color-muted);
    margin: 0 0 var(--space-3);
    max-width: 640px;
    line-height: 1.6;
  }

  .category-stats {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-dim);
  }

  .category-stats__sep {
    color: var(--color-border);
  }

  .article-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .article-item {
    border-bottom: 1px solid var(--color-border);
  }

  .article-item:last-child {
    border-bottom: none;
  }

  .article-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 16px;
    text-decoration: none;
    color: inherit;
    transition: background var(--motion-fast) ease;
    min-height: 44px;
  }

  .article-link:hover {
    background: var(--color-surface-2);
    text-decoration: none;
  }

  .article-title {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
  }

  .article-link:hover .article-title {
    color: var(--color-primary);
  }

  .article-desc {
    font-size: 12px;
    color: var(--color-dim);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 767px) {
    .category-header {
      padding-bottom: var(--space-4);
      margin-bottom: var(--space-4);
    }
    .article-link {
      padding: 10px 12px;
    }
    .article-title {
      font-size: 13px;
    }
  }
</style>
